        ]
      }
    ];

    // Three.js Globals
    let scene, camera, renderer, deviceGroup, currentModelMeshGroup, macbookLidPivot, contactShadowMesh;
    let mainDirLight, fillLight, rimLight, ambientLight;
    let screenTexture, screenCanvas, screenCtx, uploadedVideoElement = null;
    let hardwareMaterials = [];
    let activeScreenMaterials = [];
    let activeGlassOverlayMaterials = [];
    let dynamicIslandMeshRef = null;
    let studioEnvMap = null;
    let isUsingRealGltfModels = false;

    // Custom Orbit Camera State
    const orbit = {
      isDragging: false,
      isPanning: false,
      prevX: 0,
      prevY: 0,
      target: new THREE.Vector3(0, 0, 0)
    };

    /********************************************************************
     * 2. PROCEDURAL 2D SCREEN TEXTURE ENGINE (TRUE sRGB + ASPECT FIT)
     ********************************************************************/
    let activeDemoStyle = 'fintech';
    let demoAnimTick = 0;
    let customUploadedImage = null;

    // Configure texture with strict sRGB ColorSpace & Max Anisotropy so screenshots never wash out
    function applyStrictSRGBAndSharpness(tex) {
      if (!tex) return;
      // Support both modern Three.js (r152+) and Three.js r128
      if ('colorSpace' in tex && THREE.SRGBColorSpace) {
        tex.colorSpace = THREE.SRGBColorSpace;
      }
      if (THREE.sRGBEncoding !== undefined) {
        tex.encoding = THREE.sRGBEncoding;
      } else {
        tex.encoding = 3001; // Explicit sRGBEncoding constant fallback
      }
      if (renderer && renderer.capabilities) {
        tex.anisotropy = renderer.capabilities.getMaxAnisotropy();
      } else {
        tex.anisotropy = 16;
      }
      tex.minFilter = THREE.LinearFilter;
      tex.magFilter = THREE.LinearFilter;
      tex.generateMipmaps = false;
      tex.needsUpdate = true;
    }

    function getTargetCanvasDimensions() {
      if (state.deviceType === 'macbook') {
        return { w: 1920, h: 1240 }; // 16:10 MacBook aspect
      } else if (state.deviceType === 'ipad') {
        return { w: 1536, h: 2048 }; // 3:4 iPad Pro aspect
      }
      return { w: 1080, h: 2220 };   // iPhone 15 Pro aspect
    }

    function syncScreenCanvasAspect() {
      if (!screenCanvas) return;
      const { w, h } = getTargetCanvasDimensions();
      if (screenCanvas.width !== w || screenCanvas.height !== h) {
        screenCanvas.width = w;
        screenCanvas.height = h;
        if (screenTexture) {
          screenTexture.dispose();
          screenTexture = new THREE.CanvasTexture(screenCanvas);
          applyStrictSRGBAndSharpness(screenTexture);
          activeScreenMaterials.forEach(mat => {
            mat.map = screenTexture;
            mat.needsUpdate = true;
          });
        }
      }
    }


    function createRoundedRectShape(w, h, r) {
      r = Math.min(r, w / 2, h / 2);
      const shape = new THREE.Shape(), x = -w / 2, y = -h / 2;
      shape.moveTo(x + r, y);
      shape.lineTo(x + w - r, y); shape.quadraticCurveTo(x + w, y, x + w, y + r);
      shape.lineTo(x + w, y + h - r); shape.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
      shape.lineTo(x + r, y + h); shape.quadraticCurveTo(x, y + h, x, y + h - r);
      shape.lineTo(x, y + r); shape.quadraticCurveTo(x, y, x + r, y);
      return shape;
    }
    function createScreenPlaneWithUVs(w, h, r) {
      const geometry = new THREE.ShapeGeometry(createRoundedRectShape(w, h, r), 24);
      const positions = geometry.attributes.position, uv = geometry.attributes.uv;
      for (let i = 0; i < positions.count; i++) uv.setXY(i, positions.getX(i) / w + 0.5, positions.getY(i) / h + 0.5);
      return geometry;
    }
    function drawProceduralScreen(tick = 0) {
      if (!screenCtx) return;
      const ctx = screenCtx, w = screenCanvas.width, h = screenCanvas.height;
      ctx.fillStyle = '#101827'; ctx.fillRect(0, 0, w, h);
      const media = uploadedVideoElement || customUploadedImage;
      if (media) {
        const mw = media.videoWidth || media.naturalWidth, mh = media.videoHeight || media.naturalHeight;
        if (mw && mh) {
          const scale = state.screenFitMode === 'contain' ? Math.min(w / mw, h / mh) : Math.max(w / mw, h / mh);
          ctx.drawImage(media, (w - mw * scale) / 2, (h - mh * scale) / 2, mw * scale, mh * scale);
        }
      } else {
        ctx.save(); ctx.scale(w / 1080, h / 2220);
        ctx.fillStyle = '#f8fafc'; ctx.font = '500 36px sans-serif'; ctx.fillText('9:41', 80, 90);
        ctx.fillStyle = '#94a3b8'; ctx.font = '38px sans-serif'; ctx.fillText('Welcome back', 80, 290);
        ctx.fillStyle = '#ffffff'; ctx.font = 'bold 76px sans-serif';
        ctx.fillText(activeDemoStyle === 'ai' ? 'Your AI assistant' : activeDemoStyle === 'analytics' ? 'Overview' : 'Your balance', 80, 400);
        const gradient = ctx.createLinearGradient(80, 490, 1000, 1000);
        gradient.addColorStop(0, '#10b981'); gradient.addColorStop(1, '#065f46');
        ctx.fillStyle = gradient; ctx.fillRect(80, 490, 920, 510);
        ctx.fillStyle = '#ffffff'; ctx.font = 'bold 110px sans-serif';
        ctx.fillText(activeDemoStyle === 'ai' ? 'Hello there.' : '$24,680', 130, 710);
        ctx.font = '36px sans-serif'; ctx.fillText(activeDemoStyle === 'ai' ? 'What can I help you create?' : '+12.8% this month', 130, 820);
        ctx.fillStyle = '#ffffff'; ctx.font = 'bold 48px sans-serif'; ctx.fillText('Recent activity', 80, 1140);
        ['Design subscription', 'Project payment', 'Coffee & friends', 'Savings deposit'].forEach((label, i) => {
          const y = 1260 + i * 170;
          ctx.fillStyle = '#202d42'; ctx.fillRect(80, y - 55, 920, 130);
          ctx.fillStyle = '#e2e8f0'; ctx.font = '36px sans-serif'; ctx.fillText(label, 125, y + 20);
        });
        ctx.fillStyle = '#10b981'; ctx.fillRect(80, 2040, 920, 90);
        ctx.restore();
      }
      if (screenTexture) screenTexture.needsUpdate = true;
    }
    function generateDemoScreen(style) {
      if (uploadedVideoElement) { uploadedVideoElement.pause(); URL.revokeObjectURL(uploadedVideoElement.src); }
      uploadedVideoElement = null; customUploadedImage = null; activeDemoStyle = style;
      drawProceduralScreen();
    }
    function handleScreenMediaUpload(event) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;
      if (uploadedVideoElement) { uploadedVideoElement.pause(); URL.revokeObjectURL(uploadedVideoElement.src); }
      uploadedVideoElement = null; customUploadedImage = null;
      const url = URL.createObjectURL(file);
      if (file.type.startsWith('video/')) {
        const video = document.createElement('video');
        video.muted = true; video.loop = true; video.playsInline = true;
        video.onloadeddata = () => { uploadedVideoElement = video; drawProceduralScreen(); video.play().catch(console.warn); };
        video.src = url;
      } else {
        const image = new Image();
        image.onload = () => { customUploadedImage = image; drawProceduralScreen(); URL.revokeObjectURL(url); };
        image.src = url;
      }
    }

    function initScreenCanvas() {
      screenCanvas = document.createElement('canvas');
      const { w, h } = getTargetCanvasDimensions();
      screenCanvas.width = w;
      screenCanvas.height = h;
      screenCtx = screenCanvas.getContext('2d');
      screenTexture = new THREE.CanvasTexture(screenCanvas);
      applyStrictSRGBAndSharpness(screenTexture);
      drawProceduralScreen(0);
    }

    /********************************************************************
     * 3B. PROCEDURAL FALLBACK MODELS & REAL GLTF 3D MODEL LOADER
     ********************************************************************/
    function createStudioEnvironmentMap() {
      const pmremGenerator = new THREE.PMREMGenerator(renderer);
      pmremGenerator.compileEquirectangularShader();

      // Create a procedural HDR-grade studio gradient background for gorgeous physical reflections
      const canvas = document.createElement('canvas');
      canvas.width = 1024;
      canvas.height = 512;
      const ctx = canvas.getContext('2d');
      const grad = ctx.createLinearGradient(0, 0, 0, 512);
      grad.addColorStop(0, '#1e293b');
      grad.addColorStop(0.4, '#475569');
      grad.addColorStop(0.5, '#0f172a');
      grad.addColorStop(0.8, '#1e293b');
      grad.addColorStop(1, '#020617');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, 1024, 512);

      // Studio overhead soft box strip
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(384, 40, 256, 40);

      const tex = new THREE.CanvasTexture(canvas);
      tex.mapping = THREE.EquirectangularReflectionMapping;
      studioEnvMap = pmremGenerator.fromEquirectangular(tex).texture;
      scene.environment = studioEnvMap;
    }

    function getBodyMaterial() {
      const mat = new THREE.MeshStandardMaterial({
        color: state.clayMode ? '#e4e4e7' : state.deviceColor,
        metalness: state.clayMode ? 0.05 : state.deviceMetalness,
        roughness: state.clayMode ? 0.85 : state.deviceRoughness,
        envMap: studioEnvMap,
        envMapIntensity: 1.25
      });
      hardwareMaterials.push(mat);
      return mat;
    }

    function createTrueColorScreenAndGlass(width, height, radius, zOffset) {
      const container = new THREE.Group();

      const scrGeom = createScreenPlaneWithUVs(width, height, radius);
      const b = state.screenBrightness;
      const scrMat = new THREE.MeshBasicMaterial({
        map: screenTexture,
        color: new THREE.Color(b, b, b),
        toneMapped: false
      });
      activeScreenMaterials.push(scrMat);

      const scrMesh = new THREE.Mesh(scrGeom, scrMat);
      scrMesh.position.z = zOffset;
      scrMesh.name = 'activeScreen';
      if (state.clayMode) scrMesh.visible = false;
      container.add(scrMesh);

      const glassGeom = createScreenPlaneWithUVs(width, height, radius);
      const glassMat = new THREE.MeshPhysicalMaterial({
        color: 0xffffff,
        transparent: true,
        opacity: state.screenGlare * 0.35,
        roughness: 0.06,
        metalness: 0.1,
        reflectivity: 0.95,
        clearcoat: 1.0,
        clearcoatRoughness: 0.04,
        envMap: studioEnvMap,
        envMapIntensity: 1.5,
        depthWrite: false
      });
      activeGlassOverlayMaterials.push(glassMat);

      const glassMesh = new THREE.Mesh(glassGeom, glassMat);
      glassMesh.position.z = zOffset + 0.004;
      glassMesh.visible = !state.clayMode && state.screenGlare > 0.001;
      container.add(glassMesh);

      return container;
    }

    function buildIPhone15Pro() {
      const group = new THREE.Group();
      const w = 7.4, h = 15.2, depth = 0.72, r = 1.15;

      const shape = createRoundedRectShape(w, h, r);
      const chassisGeom = new THREE.ExtrudeGeometry(shape, {
        depth: depth,
        bevelEnabled: true,
        bevelSegments: 6,
        steps: 1,
        bevelSize: 0.08,
        bevelThickness: 0.08
      });
      chassisGeom.center();
      const bodyMat = getBodyMaterial();
      const chassisMesh = new THREE.Mesh(chassisGeom, bodyMat);
      group.add(chassisMesh);

      const bezelGeom = createScreenPlaneWithUVs(w - 0.18, h - 0.18, r - 0.06);
      const bezelMat = new THREE.MeshBasicMaterial({ color: 0x050507 });
      const bezelMesh = new THREE.Mesh(bezelGeom, bezelMat);
      bezelMesh.position.z = depth / 2 + 0.082;
      group.add(bezelMesh);

      const screenUnit = createTrueColorScreenAndGlass(w - 0.48, h - 0.48, r - 0.18, depth / 2 + 0.086);
      group.add(screenUnit);

      const islandShape = createRoundedRectShape(2.1, 0.52, 0.26);
      const islandGeom = new THREE.ShapeGeometry(islandShape, 16);
      const islandMat = new THREE.MeshBasicMaterial({ color: 0x000000 });
      const islandMesh = new THREE.Mesh(islandGeom, islandMat);
      islandMesh.position.set(0, h / 2 - 0.85, depth / 2 + 0.095);
      islandMesh.visible = state.showDynamicIsland && !state.clayMode;
      dynamicIslandMeshRef = islandMesh;
      group.add(islandMesh);

      const bumpShape = createRoundedRectShape(3.2, 3.2, 0.65);
      const bumpGeom = new THREE.ExtrudeGeometry(bumpShape, { depth: 0.22, bevelEnabled: true, bevelSize: 0.05, bevelThickness: 0.05 });
      const bumpMesh = new THREE.Mesh(bumpGeom, bodyMat);
      bumpMesh.position.set(w / 2 - 2.0, h / 2 - 2.0, -depth / 2 - 0.26);
      group.add(bumpMesh);

      const lensCoords = [[-0.75, 0.75], [-0.75, -0.75], [0.75, 0.0]];
      const lensGeom = new THREE.CylinderGeometry(0.58, 0.58, 0.18, 24);
      lensGeom.rotateX(Math.PI / 2);
      lensCoords.forEach(([lx, ly]) => {
        const lensRing = new THREE.Mesh(lensGeom, bodyMat);
        lensRing.position.set(w / 2 - 2.0 + lx, h / 2 - 2.0 + ly, -depth / 2 - 0.32);
        group.add(lensRing);
      });

      return group;
    }

    function buildMacBookPro() {
      const group = new THREE.Group();
      const bodyMat = getBodyMaterial();
      const w = 18.0, d = 12.2, baseH = 0.55;

      const baseShape = createRoundedRectShape(w, d, 0.7);
      const baseGeom = new THREE.ExtrudeGeometry(baseShape, {
        depth: baseH,
        bevelEnabled: true,
        bevelSize: 0.06,
        bevelThickness: 0.06
      });
      baseGeom.rotateX(Math.PI / 2);
      baseGeom.center();
      const baseMesh = new THREE.Mesh(baseGeom, bodyMat);
      baseMesh.position.y = -3.5;
      group.add(baseMesh);

      const kbGeom = new THREE.BoxGeometry(w - 2.2, 0.05, d * 0.48);
      const kbMat = new THREE.MeshStandardMaterial({ color: 0x111115, roughness: 0.8 });
      const kbMesh = new THREE.Mesh(kbGeom, kbMat);
      kbMesh.position.set(0, -3.5 + baseH / 2 + 0.04, -1.1);
      group.add(kbMesh);

      const tpGeom = new THREE.BoxGeometry(4.6, 0.03, 2.9);
      const tpMesh = new THREE.Mesh(tpGeom, bodyMat);
      tpMesh.position.set(0, -3.5 + baseH / 2 + 0.04, 3.2);
      group.add(tpMesh);

      macbookLidPivot = new THREE.Group();
      macbookLidPivot.position.set(0, -3.5 + baseH / 2, -d / 2 + 0.3);

      const lidShape = createRoundedRectShape(w, d, 0.7);
      const lidGeom = new THREE.ExtrudeGeometry(lidShape, {
        depth: 0.28,
        bevelEnabled: true,
        bevelSize: 0.04,
        bevelThickness: 0.04
      });
      lidGeom.center();
      const lidMesh = new THREE.Mesh(lidGeom, bodyMat);
      lidMesh.position.set(0, d / 2, 0);
      macbookLidPivot.add(lidMesh);

      const screenUnit = createTrueColorScreenAndGlass(w - 0.9, d - 1.0, 0.35, 0.19);
      screenUnit.position.y = d / 2;
      macbookLidPivot.add(screenUnit);

      const rad = THREE.MathUtils.degToRad(state.macbookLidAngle - 90);
      macbookLidPivot.rotation.x = -rad;

      group.add(macbookLidPivot);
      return group;
    }

    function buildIPadPro() {
      const group = new THREE.Group();
      const w = 12.6, h = 16.8, depth = 0.48, r = 0.95;

      const shape = createRoundedRectShape(w, h, r);
      const chassisGeom = new THREE.ExtrudeGeometry(shape, {
        depth: depth,
        bevelEnabled: true,
        bevelSegments: 5,
        bevelSize: 0.06,
        bevelThickness: 0.06
      });
      chassisGeom.center();
      const bodyMat = getBodyMaterial();
      const chassisMesh = new THREE.Mesh(chassisGeom, bodyMat);
      group.add(chassisMesh);

      const screenUnit = createTrueColorScreenAndGlass(w - 0.8, h - 0.8, r - 0.2, depth / 2 + 0.065);
      group.add(screenUnit);

      return group;
    }

    function createSoftShadowMesh() {
      const canvas = document.createElement('canvas');
      canvas.width = 256;
      canvas.height = 256;
      const ctx = canvas.getContext('2d');
      const grad = ctx.createRadialGradient(128, 128, 10, 128, 128, 120);
      grad.addColorStop(0, 'rgba(0, 0, 0, 0.75)');
      grad.addColorStop(0.5, 'rgba(0, 0, 0, 0.25)');
      grad.addColorStop(1, 'rgba(0, 0, 0, 0.0)');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, 256, 256);

      const tex = new THREE.CanvasTexture(canvas);
      const geom = new THREE.PlaneGeometry(18, 10);
      geom.rotateX(-Math.PI / 2);
      const mat = new THREE.MeshBasicMaterial({
        map: tex,
        transparent: true,
        opacity: 0.65,
        depthWrite: false
      });
      const mesh = new THREE.Mesh(geom, mat);
      mesh.position.y = -9.2;
      return mesh;
    }

    function initThreeScene() {
      const container = document.getElementById('canvas-container');
      scene = new THREE.Scene();

      camera = new THREE.PerspectiveCamera(35, container.clientWidth / container.clientHeight, 0.1, 500);
      camera.position.set(0, 0, 30.52);

      renderer = new THREE.WebGLRenderer({
        antialias: true,
        alpha: true,
        preserveDrawingBuffer: true,
        powerPreference: 'high-performance'
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      const initW = Math.max(2, Math.floor(container.clientWidth / 2) * 2);
      const initH = Math.max(2, Math.floor(container.clientHeight / 2) * 2);
      renderer.setSize(initW, initH);
      if ('outputColorSpace' in renderer && THREE.SRGBColorSpace) {
        renderer.outputColorSpace = THREE.SRGBColorSpace;
      } else {
        renderer.outputEncoding = THREE.sRGBEncoding;
      }
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.15;
      container.appendChild(renderer.domElement);

      // Generate Studio Environment Map for realistic metallic reflections
      createStudioEnvironmentMap();

      ambientLight = new THREE.AmbientLight(0xffffff, 0.65);
      scene.add(ambientLight);

      mainDirLight = new THREE.DirectionalLight(0xffffff, 1.3);
      mainDirLight.position.set(18, 25, 22);
      scene.add(mainDirLight);

      fillLight = new THREE.DirectionalLight(0x93c5fd, 0.6);
      fillLight.position.set(-20, 10, 15);
      scene.add(fillLight);

      rimLight = new THREE.PointLight(0x34d399, 1.0, 70);
      rimLight.position.set(0, 16, -18);
      scene.add(rimLight);

      deviceGroup = new THREE.Group();
      scene.add(deviceGroup);

      contactShadowMesh = createSoftShadowMesh();
      scene.add(contactShadowMesh);

      initScreenCanvas();
      rebuildActiveDeviceModel();
      setupViewportInteractions(renderer.domElement);

      window.addEventListener('resize', handleWindowResize);
      setTimeout(handleWindowResize, 50);
    }

    function rebuildActiveDeviceModel() {
      hardwareMaterials = [];
      activeScreenMaterials = [];
      activeGlassOverlayMaterials = [];
      dynamicIslandMeshRef = null;

      if (currentModelMeshGroup) {
        deviceGroup.remove(currentModelMeshGroup);
      }

      syncScreenCanvasAspect();
      drawProceduralScreen(demoAnimTick);

      if (state.deviceType === 'iphone') {
        currentModelMeshGroup = buildIPhone15Pro();
        contactShadowMesh.position.y = -9.2;
        contactShadowMesh.scale.set(0.9, 0.9, 1);
      } else if (state.deviceType === 'macbook') {
        currentModelMeshGroup = buildMacBookPro();
        contactShadowMesh.position.y = -5.0;
        contactShadowMesh.scale.set(1.5, 1.4, 1);
      } else {
        currentModelMeshGroup = buildIPadPro();
        contactShadowMesh.position.y = -9.8;
        contactShadowMesh.scale.set(1.2, 1.0, 1);
      }

      // Apply environment map & physical properties to newly created materials
      hardwareMaterials.forEach(mat => {
        if (studioEnvMap) {
          mat.envMap = studioEnvMap;
          mat.envMapIntensity = 1.3;
          mat.needsUpdate = true;
        }
      });

      deviceGroup.add(currentModelMeshGroup);
    }

    // Screen Display Controls (Fit Mode, Brightness, Glare, Dynamic Island)
    function setScreenFitMode(mode) {
      state.screenFitMode = mode;
      const coverBtn = document.getElementById('fit-btn-cover');
      const containBtn = document.getElementById('fit-btn-contain');
      if (mode === 'cover') {
        coverBtn.className = 'px-2 py-0.5 rounded-md text-[10px] font-medium bg-emerald-500 text-white transition';
        containBtn.className = 'px-2 py-0.5 rounded-md text-[10px] font-medium text-zinc-400 hover:text-white transition';
      } else {
        containBtn.className = 'px-2 py-0.5 rounded-md text-[10px] font-medium bg-emerald-500 text-white transition';
        coverBtn.className = 'px-2 py-0.5 rounded-md text-[10px] font-medium text-zinc-400 hover:text-white transition';
      }
      drawProceduralScreen(demoAnimTick);
      showToast(`Screen aspect mode: ${mode.toUpperCase()}`);
    }

    function updateScreenBrightness(val) {
      const pct = parseFloat(val) || 100;
      state.screenBrightness = pct / 100;
      document.getElementById('screen-brightness-val').textContent = `${Math.round(pct)}%`;
      const b = state.screenBrightness;
      activeScreenMaterials.forEach(mat => {
        mat.color.setRGB(b, b, b);
      });
    }

    function updateScreenGlare(val) {
      const pct = parseFloat(val) || 0;
      state.screenGlare = pct / 100;
      document.getElementById('screen-glare-val').textContent = `${Math.round(pct)}%`;
      activeGlassOverlayMaterials.forEach(mat => {
        mat.opacity = state.screenGlare * 0.35;
        mat.needsUpdate = true;
      });
      if (currentModelMeshGroup) {
        currentModelMeshGroup.traverse(obj => {
          if (obj.isMesh && activeGlassOverlayMaterials.includes(obj.material)) {
            obj.visible = !state.clayMode && state.screenGlare > 0.001;
          }
        });
      }
    }

    function toggleDynamicIsland() {
      state.showDynamicIsland = !state.showDynamicIsland;
      const btn = document.getElementById('island-toggle-btn');
      const knob = document.getElementById('island-toggle-knob');
      btn.setAttribute('aria-checked', state.showDynamicIsland);
      btn.className = state.showDynamicIsland
        ? 'w-9 h-5 rounded-full bg-emerald-500 relative transition-colors'
        : 'w-9 h-5 rounded-full bg-zinc-300 dark:bg-zinc-700 relative transition-colors';
      knob.style.transform = state.showDynamicIsland ? 'translateX(16px)' : 'translateX(0px)';
      if (dynamicIslandMeshRef) {
        dynamicIslandMeshRef.visible = state.showDynamicIsland && !state.clayMode;
      }
    }

    /********************************************************************
     * 4. VIEWPORT INTERACTIONS (ORBIT, PAN, ZOOM & DRAG-AND-DROP)
     ********************************************************************/
    function setupViewportInteractions(domElem) {
      domElem.addEventListener('mousedown', (e) => {
        if (state.isPlaying) {
          state.isPlaying = false;
          updatePlayButtonIcon();
        }
        orbit.isDragging = true;
        orbit.isPanning = e.button === 2 || e.shiftKey;
        orbit.prevX = e.clientX;
        orbit.prevY = e.clientY;
      });

      window.addEventListener('mousemove', (e) => {
        if (!orbit.isDragging) return;
        const dx = e.clientX - orbit.prevX;
        const dy = e.clientY - orbit.prevY;
        orbit.prevX = e.clientX;
        orbit.prevY = e.clientY;

        if (orbit.isPanning) {
          camera.position.x -= dx * 0.03;
          camera.position.y += dy * 0.03;
        } else {
          deviceGroup.rotation.y += dx * 0.0085;
          deviceGroup.rotation.x += dy * 0.0085;
        }
        syncCameraInspectorFromThree();
        syncDeviceSlidersFromMesh();
      });

      window.addEventListener('mouseup', () => {
        orbit.isDragging = false;
      });

      domElem.addEventListener('contextmenu', (e) => e.preventDefault());

      // Touch support for mobile/tablet
      domElem.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          if (state.isPlaying) {
            state.isPlaying = false;
            updatePlayButtonIcon();
          }
          orbit.isDragging = true;
          orbit.isPanning = false;
          orbit.prevX = e.touches[0].clientX;
          orbit.prevY = e.touches[0].clientY;
        }
      }, { passive: true });

      window.addEventListener('touchmove', (e) => {
        if (!orbit.isDragging || e.touches.length !== 1) return;
        const dx = e.touches[0].clientX - orbit.prevX;
        const dy = e.touches[0].clientY - orbit.prevY;
        orbit.prevX = e.touches[0].clientX;
        orbit.prevY = e.touches[0].clientY;
        deviceGroup.rotation.y += dx * 0.0085;
        deviceGroup.rotation.x += dy * 0.0085;
        syncCameraInspectorFromThree();
        syncDeviceSlidersFromMesh();
      }, { passive: true });

      window.addEventListener('touchend', () => {
        orbit.isDragging = false;
      });

      // Mouse Wheel Dolly Zoom
      domElem.addEventListener('wheel', (e) => {
        e.preventDefault();
        camera.position.z = THREE.MathUtils.clamp(camera.position.z + e.deltaY * 0.02, 8, 85);
        syncCameraInspectorFromThree();
      }, { passive: false });

      // Drag and drop screenshot/video directly onto the 3D stage
      const container = document.getElementById('canvas-container');
      container.addEventListener('dragover', (e) => {
        e.preventDefault();
      });
      container.addEventListener('drop', (e) => {
        e.preventDefault();
        if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
          handleScreenMediaUpload({ target: { files: e.dataTransfer.files } });
        }
      });
    }

    /********************************************************************
     * 5. CAMERA & DEVICE TRANSFORM SYNCHRONIZATION
     ********************************************************************/
    function syncCameraInspectorFromThree() {
      if (!camera) return;
      document.getElementById('cam-pos-x').value = camera.position.x.toFixed(2);
      document.getElementById('cam-pos-y').value = camera.position.y.toFixed(2);
      document.getElementById('cam-pos-z').value = camera.position.z.toFixed(2);
      document.getElementById('cam-rot-x').value = THREE.MathUtils.radToDeg(camera.rotation.x).toFixed(1);
      document.getElementById('cam-rot-y').value = THREE.MathUtils.radToDeg(camera.rotation.y).toFixed(1);
      document.getElementById('cam-rot-z').value = THREE.MathUtils.radToDeg(camera.rotation.z).toFixed(1);
    }

    function applyCameraInputs() {
      if (!camera) return;
      camera.position.set(
        parseFloat(document.getElementById('cam-pos-x').value) || 0,
        parseFloat(document.getElementById('cam-pos-y').value) || 0,
        parseFloat(document.getElementById('cam-pos-z').value) || 30.52
      );
      camera.rotation.set(
        THREE.MathUtils.degToRad(parseFloat(document.getElementById('cam-rot-x').value) || 0),
        THREE.MathUtils.degToRad(parseFloat(document.getElementById('cam-rot-y').value) || 0),
        THREE.MathUtils.degToRad(parseFloat(document.getElementById('cam-rot-z').value) || 0)
      );
    }

    function syncDeviceSlidersFromMesh() {
      if (!deviceGroup) return;
      const rx = THREE.MathUtils.radToDeg(deviceGroup.rotation.x);
      const ry = THREE.MathUtils.radToDeg(deviceGroup.rotation.y);
      const rz = THREE.MathUtils.radToDeg(deviceGroup.rotation.z);

      document.getElementById('dev-rot-x').value = THREE.MathUtils.clamp(rx, -90, 90);
      document.getElementById('dev-rot-y').value = THREE.MathUtils.clamp(ry, -180, 180);
      document.getElementById('dev-rot-z').value = THREE.MathUtils.clamp(rz, -90, 90);

      document.getElementById('dev-rot-x-val').textContent = `${rx.toFixed(1)}°`;
      document.getElementById('dev-rot-y-val').textContent = `${ry.toFixed(1)}°`;
      document.getElementById('dev-rot-z-val').textContent = `${rz.toFixed(1)}°`;
    }

    function updateDeviceTransformFromUI() {
      if (!deviceGroup) return;
      const rx = parseFloat(document.getElementById('dev-rot-x').value) || 0;
      const ry = parseFloat(document.getElementById('dev-rot-y').value) || 0;
      const rz = parseFloat(document.getElementById('dev-rot-z').value) || 0;

      deviceGroup.rotation.set(
        THREE.MathUtils.degToRad(rx),
        THREE.MathUtils.degToRad(ry),
        THREE.MathUtils.degToRad(rz)
      );

      document.getElementById('dev-rot-x-val').textContent = `${rx.toFixed(1)}°`;
      document.getElementById('dev-rot-y-val').textContent = `${ry.toFixed(1)}°`;
      document.getElementById('dev-rot-z-val').textContent = `${rz.toFixed(1)}°`;
    }

    function nudgeDeviceRotation(dx, dy, dz) {
      if (!deviceGroup) return;
      deviceGroup.rotation.x += THREE.MathUtils.degToRad(dx);
      deviceGroup.rotation.y += THREE.MathUtils.degToRad(dy);
      deviceGroup.rotation.z += THREE.MathUtils.degToRad(dz);
      syncDeviceSlidersFromMesh();
    }

    function resetDeviceRotation() {
      if (!deviceGroup) return;
      deviceGroup.rotation.set(0, 0, 0);
      syncDeviceSlidersFromMesh();
    }

    /********************************************************************
     * 6. KEYFRAME TIMELINE, EASING CURVES & STUDIO TEMPLATE ENGINE
     ********************************************************************/
    function computeEasing(t, mode) {
      const clamped = THREE.MathUtils.clamp(t, 0, 1);
      if (mode === 'linear') return clamped;
      if (mode === 'expo') {
        return clamped === 1 ? 1 : 1 - Math.pow(2, -10 * clamped);
      }
      if (mode === 'spring') {
        const c1 = 1.70158;
        const c3 = c1 + 1;
        return 1 + c3 * Math.pow(clamped - 1, 3) + c1 * Math.pow(clamped - 1, 2);
      }
      // Default: Ease In-Out Cubic
      return clamped < 0.5
        ? 4 * clamped * clamped * clamped
        : 1 - Math.pow(-2 * clamped + 2, 3) / 2;
    }

    function setEasingCurve(mode) {
      state.easingMode = mode;
      const sel = document.getElementById('easing-curve-select');
      if (sel) sel.value = mode;

      const labels = {
        cubic: 'Cubic',
        expo: 'Expo Out',
        spring: 'Spring',
        linear: 'Linear'
      };
      const fullLabels = {
        cubic: 'Ease In-Out Cubic',
        expo: 'Expo Out (Cinema Snap)',
        spring: 'Spring / Overshoot',
        linear: 'Linear'
      };

      const btn = document.getElementById('timeline-easing-btn');
      if (btn) btn.textContent = labels[mode] || 'Cubic';

      const modalInd = document.getElementById('modal-easing-indicator');
      if (modalInd) modalInd.textContent = fullLabels[mode] || 'Ease In-Out Cubic';

      evaluateTimelineAtTime(state.currentTime);
      showToast(`Easing curve: ${fullLabels[mode] || mode}`);
    }

    function cycleEasingMode() {
      const order = ['cubic', 'expo', 'spring', 'linear'];
      const idx = order.indexOf(state.easingMode);
      const next = order[(idx + 1) % order.length];
      setEasingCurve(next);
    }

    function evaluateTimelineAtTime(t) {
      state.currentTime = THREE.MathUtils.clamp(t, 0, state.duration);
      const timeInput = document.getElementById('current-time-input');
      if (timeInput) timeInput.value = state.currentTime.toFixed(2);

      // Update Playhead UI position
      const ruler = document.getElementById('timeline-ruler');
      const playhead = document.getElementById('playhead-line');
      if (ruler && playhead) {
        const rulerWidth = Math.max(10, ruler.clientWidth - 32);
        const norm = state.duration > 0 ? state.currentTime / state.duration : 0;
        const leftPx = 288 + 16 + norm * rulerWidth;
        playhead.style.left = `${leftPx}px`;
      }

      if (!state.keyframes || state.keyframes.length === 0 || !camera || !deviceGroup) return;

      const sorted = [...state.keyframes].sort((a, b) => a.time - b.time);
      let k1 = sorted[0];
      let k2 = sorted[sorted.length - 1];

      if (state.currentTime <= k1.time) {
        applyKeyframePose(k1, k1, 0);
        return;
      }
      if (state.currentTime >= k2.time) {
        applyKeyframePose(k2, k2, 0);
        return;
      }

      for (let i = 0; i < sorted.length - 1; i++) {
        if (state.currentTime >= sorted[i].time && state.currentTime <= sorted[i + 1].time) {
          k1 = sorted[i];
          k2 = sorted[i + 1];
          break;
        }
      }

      const span = Math.max(0.0001, k2.time - k1.time);
      const rawAlpha = (state.currentTime - k1.time) / span;
      const easedAlpha = computeEasing(rawAlpha, state.easingMode);
      applyKeyframePose(k1, k2, easedAlpha);
    }

    function applyKeyframePose(k1, k2, alpha) {
      camera.position.set(
        THREE.MathUtils.lerp(k1.camPos.x, k2.camPos.x, alpha),
        THREE.MathUtils.lerp(k1.camPos.y, k2.camPos.y, alpha),
        THREE.MathUtils.lerp(k1.camPos.z, k2.camPos.z, alpha)
      );
      camera.lookAt(orbit.target);

      const rx = THREE.MathUtils.lerp(k1.devRot.x, k2.devRot.x, alpha);
      const ry = THREE.MathUtils.lerp(k1.devRot.y, k2.devRot.y, alpha);
      const rz = THREE.MathUtils.lerp(k1.devRot.z, k2.devRot.z, alpha);

      deviceGroup.rotation.set(
        THREE.MathUtils.degToRad(rx),
        THREE.MathUtils.degToRad(ry),
        THREE.MathUtils.degToRad(rz)
      );

      if (state.deviceType === 'macbook' && (k1.lidAngle !== undefined || k2.lidAngle !== undefined)) {
        const l1 = k1.lidAngle !== undefined ? k1.lidAngle : state.macbookLidAngle;
        const l2 = k2.lidAngle !== undefined ? k2.lidAngle : state.macbookLidAngle;
        updateMacbookLid(THREE.MathUtils.lerp(l1, l2, alpha));
      }

      syncCameraInspectorFromThree();
      syncDeviceSlidersFromMesh();
    }

    function renderKeyframeDiamonds() {
      const bar = document.getElementById('keyframe-bar');
      const badge = document.getElementById('keyframe-count-badge');
      if (!bar) return;

      bar.innerHTML = '';
      const sorted = [...state.keyframes].sort((a, b) => a.time - b.time);
      if (badge) badge.textContent = `${sorted.length} key${sorted.length === 1 ? '' : 's'}`;

      sorted.forEach((kf) => {
        const pct = state.duration > 0 ? THREE.MathUtils.clamp((kf.time / state.duration) * 100, 0, 100) : 0;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.title = `Keyframe @ ${kf.time.toFixed(2)}s (Click to jump, Right-click to delete)`;
        btn.className = 'w-3 h-3 rotate-45 bg-emerald-400 hover:bg-white border border-zinc-900 absolute -translate-x-1/2 cursor-pointer transition-transform hover:scale-125 shadow';
        btn.style.left = `${pct}%`;

        btn.addEventListener('mousedown', (e) => {
          e.stopPropagation();
          if (e.button === 2) return;
          state.isPlaying = false;
          updatePlayButtonIcon();
          evaluateTimelineAtTime(kf.time);
        });

        btn.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (state.keyframes.length <= 2) {
            showToast('At least 2 keyframes are required');
            return;
          }
          state.keyframes = state.keyframes.filter(item => item !== kf);
          renderKeyframeDiamonds();
          evaluateTimelineAtTime(state.currentTime);
          showToast(`Deleted keyframe at ${kf.time.toFixed(2)}s`);
        });

        bar.appendChild(btn);
      });

      // Refresh ruler time ticks
      const ticksEl = document.getElementById('ruler-ticks');
      if (ticksEl) {
        const steps = 4;
        let html = '';
        for (let i = 0; i <= steps; i++) {
          const val = ((state.duration / steps) * i).toFixed(1).replace(/\.0$/, '');
          html += `<span>${val}s</span>`;
        }
        ticksEl.innerHTML = html;
      }
    }

    function captureKeyframeAtCurrentTime() {
      const t = parseFloat(state.currentTime.toFixed(2));
      const newKf = {
        time: t,
        camPos: {
          x: parseFloat(camera.position.x.toFixed(2)),
          y: parseFloat(camera.position.y.toFixed(2)),
          z: parseFloat(camera.position.z.toFixed(2))
        },
        devRot: {
          x: parseFloat(THREE.MathUtils.radToDeg(deviceGroup.rotation.x).toFixed(1)),
          y: parseFloat(THREE.MathUtils.radToDeg(deviceGroup.rotation.y).toFixed(1)),
          z: parseFloat(THREE.MathUtils.radToDeg(deviceGroup.rotation.z).toFixed(1))
        },
        lidAngle: state.macbookLidAngle
      };

      const existingIdx = state.keyframes.findIndex(k => Math.abs(k.time - t) < 0.08);
      if (existingIdx >= 0) {
        state.keyframes[existingIdx] = newKf;
        showToast(`Updated keyframe at ${t.toFixed(2)}s`);
      } else {
        state.keyframes.push(newKf);
        showToast(`Added keyframe at ${t.toFixed(2)}s`);
      }

      renderKeyframeDiamonds();
    }

    function togglePlayTimeline() {
      state.isPlaying = !state.isPlaying;
      updatePlayButtonIcon();
    }

    function updatePlayButtonIcon() {
      const btn = document.getElementById('timeline-play-btn');
      if (!btn) return;
      btn.innerHTML = state.isPlaying
        ? '<i data-lucide="pause" class="w-3.5 h-3.5 fill-current"></i>'
        : '<i data-lucide="play" class="w-3.5 h-3.5 fill-current"></i>';
      lucide.createIcons();
    }

    function updateTimelineDuration(val) {
      const oldDur = state.duration;
      const nextDur = THREE.MathUtils.clamp(parseFloat(val) || 4.0, 1.0, 12.0);
      state.duration = nextDur;
      document.getElementById('duration-input').value = nextDur.toFixed(2);

      if (oldDur > 0) {
        state.keyframes.forEach(k => {
          k.time = parseFloat(((k.time / oldDur) * nextDur).toFixed(2));
        });
      }
      renderKeyframeDiamonds();
      evaluateTimelineAtTime(Math.min(state.currentTime, nextDur));
    }

    function startScrubbing(e) {
      if (e.button === 2) return;
      state.isPlaying = false;
      updatePlayButtonIcon();

      const ruler = document.getElementById('timeline-ruler');
      const scrubToClientX = (clientX) => {
        const rect = ruler.getBoundingClientRect();
        const pad = 16;
        const usableW = Math.max(10, rect.width - pad * 2);
        const norm = THREE.MathUtils.clamp((clientX - (rect.left + pad)) / usableW, 0, 1);
        evaluateTimelineAtTime(norm * state.duration);
      };

      scrubToClientX(e.clientX);

      const onMove = (moveEvt) => scrubToClientX(moveEvt.clientX);
      const onUp = () => {
        window.removeEventListener('mousemove', onMove);
        window.removeEventListener('mouseup', onUp);
      };
      window.addEventListener('mousemove', onMove);
      window.addEventListener('mouseup', onUp);
    }

    // Studio Template Gallery & Filtering
    function filterTemplates(category) {
      state.templateCategoryFilter = category;
      document.querySelectorAll('.tpl-filter-pill').forEach(btn => {
        const isMatch = btn.getAttribute('data-cat') === category;
        if (isMatch) {
          btn.className = 'tpl-filter-pill px-2.5 py-1 rounded-md text-[10px] font-semibold bg-emerald-500 text-white transition';
        } else {
          btn.className = 'tpl-filter-pill px-2.5 py-1 rounded-md text-[10px] font-medium bg-zinc-100 dark:bg-surface-card text-zinc-400 hover:text-white transition';
        }
      });
      renderTemplateLibraryUI();
    }

    function renderTemplateLibraryUI() {
      const sidebarList = document.getElementById('sidebar-template-list');
      const modalGrid = document.getElementById('modal-template-grid');

      const filtered = STUDIO_TEMPLATES.filter(t =>
        state.templateCategoryFilter === 'all' || t.category.includes(state.templateCategoryFilter)
      );

      if (sidebarList) {
        sidebarList.innerHTML = filtered.map(t => {
          const isActive = state.activeTemplateSlug === t.slug;
          return `
            <button onclick="applyPresetTemplate('${t.slug}')" class="w-full text-left p-2.5 rounded-xl border ${isActive ? 'border-emerald-500 bg-emerald-500/10' : 'border-zinc-200 dark:border-surface-border bg-zinc-50 dark:bg-surface-card hover:border-emerald-500/60'} transition flex items-center gap-3 group">
              <div class="w-10 h-10 rounded-lg shrink-0 flex items-center justify-center text-white shadow-inner relative overflow-hidden" style="background: radial-gradient(circle at 35% 30%, ${t.bg2}, ${t.bg1});">
                <i data-lucide="${t.device === 'macbook' ? 'laptop' : t.device === 'ipad' ? 'tablet' : 'smartphone'}" class="w-4 h-4 group-hover:scale-110 transition-transform"></i>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-1">
                  <p class="text-xs font-semibold truncate">${t.name}</p>
                  <span class="text-[9px] px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-400 font-mono shrink-0">${t.badge}</span>
                </div>
                <p class="text-[10px] text-zinc-400 truncate mt-0.5">${t.subtitle}</p>
              </div>
            </button>
          `;
        }).join('');
      }

      if (modalGrid) {
        modalGrid.innerHTML = filtered.map(t => {
          const isActive = state.activeTemplateSlug === t.slug;
          return `
            <div onclick="applyPresetTemplate('${t.slug}'); closeTemplateModal();" class="cursor-pointer rounded-xl border ${isActive ? 'border-emerald-500 ring-2 ring-emerald-500/30' : 'border-zinc-200 dark:border-surface-border hover:border-emerald-500'} bg-zinc-50 dark:bg-surface-card overflow-hidden flex flex-col transition group">
              <div class="h-28 relative flex items-center justify-center overflow-hidden" style="background: radial-gradient(circle at 50% 35%, ${t.bg2}, ${t.bg1});">
                <div class="w-12 h-12 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 flex items-center justify-center text-white group-hover:scale-110 group-hover:-rotate-6 transition-transform duration-200">
                  <i data-lucide="${t.device === 'macbook' ? 'laptop' : t.device === 'ipad' ? 'tablet' : 'smartphone'}" class="w-6 h-6"></i>
                </div>
                <span class="absolute top-2.5 right-2.5 text-[9px] font-mono px-2 py-0.5 rounded-full bg-black/50 text-emerald-400 backdrop-blur-sm border border-emerald-500/30">${t.badge}</span>
                <span class="absolute bottom-2 left-2.5 text-[9px] font-mono text-white/70">${t.duration.toFixed(1)}s • ${t.keyframes.length} keys</span>
              </div>
              <div class="p-3 flex-1 flex flex-col justify-between">
                <div>
                  <h4 class="text-xs font-bold truncate group-hover:text-emerald-400 transition-colors">${t.name}</h4>
                  <p class="text-[10px] text-zinc-400 mt-0.5 line-clamp-1">${t.subtitle}</p>
                </div>
              </div>
            </div>
          `;
        }).join('');
      }

      lucide.createIcons();
    }

    function applyPresetTemplate(slug) {
      const tpl = STUDIO_TEMPLATES.find(item => item.slug === slug);
      if (!tpl) return;

      state.activeTemplateSlug = tpl.slug;
      document.getElementById('active-project-name').textContent = tpl.name;

      // Switch hardware model if needed
      if (state.deviceType !== tpl.device) {
        selectDeviceModel(tpl.device);
      }

      // Clay mode setting
      const wantClay = Boolean(tpl.clay);
      if (state.clayMode !== wantClay) {
        toggleClayMode();
      }

      // Dynamic Island setting
      const wantIsland = tpl.showIsland !== undefined ? tpl.showIsland : true;
      if (state.showDynamicIsland !== wantIsland) {
        toggleDynamicIsland();
      }

      // Idle Float setting
      const wantFloat = Boolean(tpl.idleFloat);
      if (state.idleFloat !== wantFloat) {
        toggleIdleFloat();
      }

      // Camera FOV
      if (tpl.fov) {
        document.getElementById('cam-fov-slider').value = tpl.fov;
        updateCameraFOV(tpl.fov);
      }

      // Backdrop colors
      if (tpl.bg1 && tpl.bg2) {
        setQuickGradient(tpl.bg1, tpl.bg2);
      }

      // Timeline Duration & Keyframes deep copy
      state.duration = tpl.duration || 4.0;
      document.getElementById('duration-input').value = state.duration.toFixed(2);
      state.keyframes = JSON.parse(JSON.stringify(tpl.keyframes));

      // Easing Curve
      setEasingCurve(tpl.easing || 'cubic');

      renderTemplateLibraryUI();
      renderKeyframeDiamonds();

      // Start playback from 0s to preview choreography
      evaluateTimelineAtTime(0);
      state.isPlaying = true;
      updatePlayButtonIcon();
      showToast(`Loaded "${tpl.name}"`);
    }

    function openTemplateModal() {
      document.getElementById('template-gallery-modal').classList.remove('hidden');
      renderTemplateLibraryUI();
    }

    function closeTemplateModal() {
      document.getElementById('template-gallery-modal').classList.add('hidden');
    }

    /********************************************************************
     * 7. LOCAL GPU EXPORT ENGINE (RESILIENT CODEC FALLBACK & EVEN-PIXEL FIX)
     ********************************************************************/
    let activeMediaRecorder = null;
    let isExportCanceled = false;
    let isExportingVideo = false;

    function setOutputMode(mode) {
      state.outputMode = mode;
      const photoBtn = document.getElementById('mode-btn-photo');
      const videoBtn = document.getElementById('mode-btn-video');
      const exportLabel = document.getElementById('export-btn-label');

      if (mode === 'photo') {
        photoBtn.className = 'flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-amber-400 text-amber-950 shadow-sm transition-all';
        videoBtn.className = 'flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-all';
        exportLabel.textContent = 'Export PNG';
      } else {
        videoBtn.className = 'flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-emerald-500 text-white shadow-sm transition-all';
        photoBtn.className = 'flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-all';
        exportLabel.textContent = 'Export Video';
      }
    }

    function triggerExport() {
      if (isExportingVideo) return;
      if (state.outputMode === 'photo') {
        exportHighResPhoto();
      } else {
        exportLocalWebMVideo();
      }
    }

    // Multi-stage safe MediaRecorder factory that never throws NotSupportedError across Chrome/Safari/Edge/Firefox
    function createSafeMediaRecorder(stream) {
      const candidateTypes = [
        'video/webm;codecs=vp9',
        'video/webm;codecs=vp8,opus',
        'video/webm;codecs=vp8',
        'video/webm',
        'video/mp4;codecs=avc1',
        'video/mp4'
      ];

      for (const mimeType of candidateTypes) {
        try {
          if (typeof MediaRecorder.isTypeSupported === 'function' && !MediaRecorder.isTypeSupported(mimeType)) {
            continue;
          }
          const rec = new MediaRecorder(stream, {
            mimeType,
            videoBitsPerSecond: 14000000
          });
          return { recorder: rec, mimeType };
        } catch (err) {
          // Continue to next candidate MIME type if hardware encoder rejects this profile
        }
      }

      // Final unconditional fallback with default browser settings
      const fallbackRec = new MediaRecorder(stream);
      return {
        recorder: fallbackRec,
        mimeType: fallbackRec.mimeType || 'video/webm'
      };
    }

    // Build Composite Canvas (Backdrop + 3D WebGL Canvas) so gradients/solid backgrounds export cleanly
    function renderCompositeFrame(targetW, targetH) {
      const compCanvas = document.createElement('canvas');
      compCanvas.width = targetW;
      compCanvas.height = targetH;
      const ctx = compCanvas.getContext('2d');

      if (state.backdropMode === 'gradient') {
        const grad = ctx.createRadialGradient(targetW * 0.5, targetH * 0.35, 10, targetW * 0.5, targetH * 0.5, targetW * 0.8);
        grad.addColorStop(0, state.bgColor2);
        grad.addColorStop(1, state.bgColor1);
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, targetW, targetH);
      } else if (state.backdropMode === 'solid') {
        ctx.fillStyle = state.bgColor1;
        ctx.fillRect(0, 0, targetW, targetH);
      }

      ctx.drawImage(renderer.domElement, 0, 0, targetW, targetH);
      return compCanvas;
    }

    function exportHighResPhoto() {
      const scale = parseInt(document.getElementById('export-scale-select').value) || 2;
      const container = document.getElementById('canvas-container');
      const baseW = Math.max(2, Math.floor(container.clientWidth / 2) * 2);
      const baseH = Math.max(2, Math.floor(container.clientHeight / 2) * 2);

      // Temporarily boost GPU render buffer size
      renderer.setPixelRatio(scale);
      renderer.setSize(baseW, baseH, false);
      renderer.render(scene, camera);

      const outCanvas = renderCompositeFrame(baseW * scale, baseH * scale);
      const dataUrl = outCanvas.toDataURL('image/png');

      // Restore normal viewport pixel ratio
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      handleWindowResize();

      const link = document.createElement('a');
      link.download = `rotato-mockup-${Date.now()}.png`;
      link.href = dataUrl;
      link.click();
      showToast(`Exported ${scale}x GPU Studio PNG!`);
    }

    function cancelActiveVideoExport() {
      isExportCanceled = true;
      isExportingVideo = false;
      state.isPlaying = false;
      updatePlayButtonIcon();
      if (activeMediaRecorder && activeMediaRecorder.state !== 'inactive') {
        try { activeMediaRecorder.stop(); } catch (e) {}
      }
      document.getElementById('video-export-modal').classList.add('hidden');
      document.getElementById('recording-badge').classList.add('hidden');
      handleWindowResize();
      showToast('Video export canceled');
    }

    function exportLocalWebMVideo() {
      try {
        const container = document.getElementById('canvas-container');
        const dpr = Math.min(window.devicePixelRatio || 1, 2);

        // Lock strictly to EVEN pixel dimensions so hardware H.264/VP8/VP9 encoders never fail
        const evenW = Math.max(2, Math.floor((container.clientWidth * dpr) / 2) * 2);
        const evenH = Math.max(2, Math.floor((container.clientHeight * dpr) / 2) * 2);

        renderer.setPixelRatio(1);
        renderer.setSize(evenW, evenH, false);
        camera.aspect = evenW / evenH;
        camera.updateProjectionMatrix();

        const recCanvas = document.createElement('canvas');
        recCanvas.width = evenW;
        recCanvas.height = evenH;
        const recCtx = recCanvas.getContext('2d', { alpha: true });

        // Paint initial frame before starting stream so buffer is never empty
        renderer.render(scene, camera);
        recCtx.drawImage(renderer.domElement, 0, 0, evenW, evenH);

        const streamFn = recCanvas.captureStream || recCanvas.mozCaptureStream || recCanvas.webkitCaptureStream;
        if (!streamFn) {
          showToast('Video captureStream is not supported in this browser.');
          handleWindowResize();
          return;
        }

        const stream = streamFn.call(recCanvas, 60);
        const { recorder, mimeType } = createSafeMediaRecorder(stream);
        activeMediaRecorder = recorder;
        isExportCanceled = false;
        isExportingVideo = true;

        const isMp4 = mimeType.toLowerCase().includes('mp4');
        const ext = isMp4 ? 'mp4' : 'webm';
        document.getElementById('export-codec-badge').textContent = `${ext.toUpperCase()} • ${evenW}×${evenH}`;
        document.getElementById('export-modal-status').textContent = `Recording GPU stream (${mimeType || 'default codec'})...`;
        document.getElementById('video-export-modal').classList.remove('hidden');
        document.getElementById('recording-badge').classList.remove('hidden');

        const chunks = [];
        recorder.ondataavailable = (e) => {
          if (e.data && e.data.size > 0) chunks.push(e.data);
        };

        recorder.onerror = (err) => {
          console.error('MediaRecorder runtime error:', err);
          isExportingVideo = false;
          document.getElementById('video-export-modal').classList.add('hidden');
          document.getElementById('recording-badge').classList.add('hidden');
          handleWindowResize();
          showToast('Hardware encoder interrupted — try a smaller window or Chrome.');
        };

        recorder.onstop = () => {
          isExportingVideo = false;
          document.getElementById('video-export-modal').classList.add('hidden');
          document.getElementById('recording-badge').classList.add('hidden');
          handleWindowResize();

          if (isExportCanceled || chunks.length === 0) return;

          const blob = new Blob(chunks, { type: mimeType || 'video/webm' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `rotato-animation-${Date.now()}.${ext}`;
          document.body.appendChild(a);
          a.click();
          a.remove();
          setTimeout(() => URL.revokeObjectURL(url), 8000);
          showToast(`Exported ${evenW}×${evenH} 60fps .${ext} video!`);
        };

        // Start recording with a 100ms timeslice so data chunks flush steadily
        recorder.start(100);

        // Step deterministically from t = 0 to state.duration
        state.isPlaying = false;
        updatePlayButtonIcon();
        const exportStartWall = performance.now();
        const totalDuration = state.duration;

        const recordStep = (now) => {
          if (isExportCanceled || !isExportingVideo) return;

          const elapsed = (now - exportStartWall) / 1000;
          const clampedTime = Math.min(elapsed, totalDuration);

          evaluateTimelineAtTime(clampedTime);
          if (state.idleFloat) {
            deviceGroup.position.y = Math.sin(now * 0.0025) * 0.65;
          }
          demoAnimTick++;
          if (!customUploadedImage || uploadedVideoElement) {
            drawProceduralScreen(demoAnimTick);
          }
          renderer.render(scene, camera);

          // Composite backdrop + 3D WebGL frame into even-sized recording canvas
          if (state.backdropMode === 'gradient') {
            const grad = recCtx.createRadialGradient(evenW * 0.5, evenH * 0.35, 10, evenW * 0.5, evenH * 0.5, evenW * 0.8);
            grad.addColorStop(0, state.bgColor2);
            grad.addColorStop(1, state.bgColor1);
            recCtx.fillStyle = grad;
            recCtx.fillRect(0, 0, evenW, evenH);
          } else if (state.backdropMode === 'solid') {
            recCtx.fillStyle = state.bgColor1;
            recCtx.fillRect(0, 0, evenW, evenH);
          } else {
            recCtx.clearRect(0, 0, evenW, evenH);
          }
          recCtx.drawImage(renderer.domElement, 0, 0, evenW, evenH);

          const pct = Math.min(100, Math.round((clampedTime / totalDuration) * 100));
          document.getElementById('recording-status-text').textContent = `Recording GPU Stream... ${pct}%`;
          document.getElementById('export-progress-bar').style.width = `${pct}%`;
          document.getElementById('export-pct-label').textContent = `${pct}%`;
          document.getElementById('export-time-progress').textContent = `${clampedTime.toFixed(2)}s / ${totalDuration.toFixed(2)}s`;

          if (elapsed >= totalDuration) {
            if (recorder.state === 'recording') {
              recorder.stop();
            }
            return;
          }

          requestAnimationFrame(recordStep);
        };

        requestAnimationFrame(recordStep);
      } catch (err) {
        console.error('Video export initialization failed:', err);
        isExportingVideo = false;
        document.getElementById('video-export-modal').classList.add('hidden');
        document.getElementById('recording-badge').classList.add('hidden');
        handleWindowResize();
        showToast('Video export failed: ' + (err.message || 'Encoder error'));
      }
    }

    /********************************************************************
     * 8. UI CONTROLS & INSPECTOR HELPERS
     ********************************************************************/
    function switchTab(tabId) {
      state.activeTab = tabId;
      const tabs = ['device', 'camera', 'templates', 'background', 'settings'];
      tabs.forEach(t => {
        document.getElementById(`tab-content-${t}`).classList.toggle('hidden', t !== tabId);
        const btn = document.getElementById(`tab-btn-${t}`);
        if (t === tabId) {
          btn.className = 'sidebar-tab-btn flex flex-col items-center justify-center gap-1 w-13 h-14 px-2 rounded-xl text-xs font-medium bg-emerald-500/15 text-emerald-400 transition-all';
        } else {
          btn.className = 'sidebar-tab-btn flex flex-col items-center justify-center gap-1 w-13 h-14 px-2 rounded-xl text-xs font-medium text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-200/50 dark:hover:bg-surface-hover transition-all';
        }
      });
    }

    function selectDeviceModel(type) {
      state.deviceType = type;
      ['iphone', 'macbook', 'ipad'].forEach(m => {
        const btn = document.getElementById(`model-btn-${m}`);
        if (m === type) {
          btn.className = 'device-model-btn flex flex-col items-center gap-1.5 p-2.5 rounded-xl border border-emerald-500 bg-emerald-500/10 text-emerald-500 transition';
        } else {
          btn.className = 'device-model-btn flex flex-col items-center gap-1.5 p-2.5 rounded-xl border border-zinc-200 dark:border-surface-border hover:bg-zinc-100 dark:hover:bg-surface-hover transition';
        }
      });

      document.getElementById('macbook-lid-control').classList.toggle('hidden', type !== 'macbook');
      const islandRow = document.getElementById('dynamic-island-row');
      if (islandRow) islandRow.classList.toggle('hidden', type !== 'iphone');

      const labels = { iphone: 'iPhone 15 Pro', macbook: 'MacBook Pro M3', ipad: 'iPad Pro Ultra' };
      document.getElementById('timeline-device-label').textContent = labels[type];

      rebuildActiveDeviceModel();
    }

    function updateMacbookLid(angleDeg) {
      state.macbookLidAngle = parseFloat(angleDeg);
      document.getElementById('lid-angle-label').textContent = `${Math.round(state.macbookLidAngle)}°`;
      document.getElementById('lid-angle-slider').value = state.macbookLidAngle;
      if (macbookLidPivot) {
        const rad = THREE.MathUtils.degToRad(state.macbookLidAngle - 90);
        macbookLidPivot.rotation.x = -rad;
      }
    }

    function toggleClayMode() {
      state.clayMode = !state.clayMode;
      const btn = document.getElementById('clay-toggle-btn');
      const knob = document.getElementById('clay-toggle-knob');
      btn.setAttribute('aria-checked', state.clayMode);
      btn.className = state.clayMode
        ? 'w-10 h-5 rounded-full bg-emerald-500 relative transition-colors'
        : 'w-10 h-5 rounded-full bg-zinc-300 dark:bg-zinc-700 relative transition-colors';
      knob.style.transform = state.clayMode ? 'translateX(20px)' : 'translateX(0px)';

      rebuildActiveDeviceModel();
      showToast(state.clayMode ? 'Real Clay Mode enabled' : 'Standard materials restored');
    }

    function setDeviceColor(hex, metalness, roughness) {
      state.deviceColor = hex;
      state.deviceMetalness = metalness;
      state.deviceRoughness = roughness;
      if (state.clayMode) toggleClayMode();
      hardwareMaterials.forEach(mat => {
        mat.color.set(hex);
        mat.metalness = metalness;
        mat.roughness = roughness;
      });
    }

    function updateCameraFOV(val) {
      camera.fov = parseFloat(val);
      camera.updateProjectionMatrix();
      document.getElementById('fov-label').textContent = `${val}°`;
    }

    function toggleDOF() {
      state.dofEnabled = !state.dofEnabled;
      const btn = document.getElementById('dof-toggle-btn');
      const knob = document.getElementById('dof-toggle-knob');
      btn.className = state.dofEnabled
        ? 'w-10 h-5 rounded-full bg-emerald-500 relative transition-colors'
        : 'w-10 h-5 rounded-full bg-zinc-300 dark:bg-zinc-700 relative transition-colors';
      knob.style.transform = state.dofEnabled ? 'translateX(20px)' : 'translateX(0px)';
      document.getElementById('canvas-container').style.filter = state.dofEnabled ? 'drop-shadow(0 25px 25px rgba(0,0,0,0.5))' : 'none';
    }

    function copyCameraValues() {
      state.copiedCamera = {
        pos: camera.position.clone(),
        rot: deviceGroup.rotation.clone()
      };
      showToast('Copied camera & rotation values');
    }

    function pasteCameraValues() {
      if (!state.copiedCamera) {
        showToast('No camera values copied yet');
        return;
      }
      camera.position.copy(state.copiedCamera.pos);
      deviceGroup.rotation.copy(state.copiedCamera.rot);
      syncCameraInspectorFromThree();
      syncDeviceSlidersFromMesh();
      showToast('Pasted camera values');
    }

    function setStageAspect(cssRatio, label) {
      const wrapper = document.getElementById('stage-aspect-wrapper');
      wrapper.style.aspectRatio = cssRatio;
      document.querySelectorAll('.aspect-pill').forEach(btn => {
        if (btn.textContent === label) {
          btn.className = 'aspect-pill px-2 py-1 rounded-md text-xs bg-emerald-500/20 text-emerald-400 font-semibold transition';
        } else {
          btn.className = 'aspect-pill px-2 py-1 rounded-md text-xs hover:bg-zinc-200/60 dark:hover:bg-surface-hover transition';
        }
      });
      setTimeout(handleWindowResize, 220);
    }

    function setBackdropMode(mode) {
      state.backdropMode = mode;
      ['gradient', 'solid', 'transparent'].forEach(m => {
        const btn = document.getElementById(`bg-mode-${m}`);
        btn.className = m === mode
          ? 'px-2.5 py-1.5 rounded-lg text-xs font-medium bg-emerald-500 text-white'
          : 'px-2.5 py-1.5 rounded-lg text-xs font-medium bg-zinc-100 dark:bg-surface-card';
      });
      document.getElementById('bg-color-2-row').classList.toggle('hidden', mode !== 'gradient');
      applyBackdropVisuals();
    }

    function updateBackdropColors() {
      state.bgColor1 = document.getElementById('bg-color-1').value;
      state.bgColor2 = document.getElementById('bg-color-2').value;
      applyBackdropVisuals();
    }

    function setQuickGradient(c1, c2) {
      state.bgColor1 = c1;
      state.bgColor2 = c2;
      document.getElementById('bg-color-1').value = c1;
      document.getElementById('bg-color-2').value = c2;
      if (state.backdropMode === 'transparent') setBackdropMode('gradient');
      else applyBackdropVisuals();
    }

    function applyBackdropVisuals() {
      const backdrop = document.getElementById('canvas-backdrop');
      const dot = document.getElementById('pill-color-dot');
      backdrop.classList.remove('checkerboard');

      if (state.backdropMode === 'gradient') {
        backdrop.style.background = `radial-gradient(circle at 50% 35%, ${state.bgColor2}, ${state.bgColor1})`;
        dot.style.background = state.bgColor2;
      } else if (state.backdropMode === 'solid') {
        backdrop.style.background = state.bgColor1;
        dot.style.background = state.bgColor1;
      } else {
        backdrop.style.background = 'transparent';
        backdrop.classList.add('checkerboard');
        dot.style.background = 'transparent';
      }
    }

    function updateLightingIntensity(val) {
      mainDirLight.intensity = parseFloat(val);
      document.getElementById('light-int-val').textContent = `${parseFloat(val).toFixed(1)}x`;
    }

    function updateShadowOpacity(val) {
      contactShadowMesh.material.opacity = parseFloat(val);
      document.getElementById('shadow-op-val').textContent = `${Math.round(val * 100)}%`;
    }

    function toggleIdleFloat() {
      state.idleFloat = !state.idleFloat;
      const btn = document.getElementById('idle-float-btn');
      if (btn) {
        btn.textContent = `Enable Continuous Levitation: ${state.idleFloat ? 'ON' : 'OFF'}`;
      }
      const camBtn = document.getElementById('cam-float-toggle-btn');
      const camKnob = document.getElementById('cam-float-toggle-knob');
      if (camBtn && camKnob) {
        camBtn.setAttribute('aria-checked', state.idleFloat);
        camBtn.className = state.idleFloat
          ? 'w-10 h-5 rounded-full bg-emerald-500 relative transition-colors'
          : 'w-10 h-5 rounded-full bg-zinc-300 dark:bg-zinc-700 relative transition-colors';
        camKnob.style.transform = state.idleFloat ? 'translateX(20px)' : 'translateX(0px)';
      }
      if (!state.idleFloat && deviceGroup) {
        deviceGroup.position.y = 0;
      }
    }

    function toggleTheme() {
      document.documentElement.classList.toggle('dark');
    }

    function resetEntireScene() {
      resetDeviceRotation();
      applyPresetTemplate('tilted-zoom-out');
      state.isPlaying = false;
      updatePlayButtonIcon();
      evaluateTimelineAtTime(4.0);
    }

    function showToast(msg) {
      const box = document.getElementById('toast-box');
      document.getElementById('toast-text').textContent = msg;
      box.classList.remove('opacity-0', 'translate-y-2');
      clearTimeout(box._timeout);
      box._timeout = setTimeout(() => {
        box.classList.add('opacity-0', 'translate-y-2');
      }, 2400);
    }

    function handleWindowResize() {
      if (isExportingVideo) return;
      const container = document.getElementById('canvas-container');
      if (!container || !renderer || !camera) return;
      const w = Math.max(2, Math.floor(container.clientWidth / 2) * 2);
      const h = Math.max(2, Math.floor(container.clientHeight / 2) * 2);
      if (w === 0 || h === 0) return;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.setSize(w, h);
    }

    // Keyboard Shortcuts (Spacebar to Play/Pause)
    window.addEventListener('keydown', (e) => {
      if (e.code === 'Space' && e.target.tagName !== 'INPUT') {
        e.preventDefault();
        togglePlayTimeline();
      }
    });

    /********************************************************************
     * 9. MAIN GPU RENDER LOOP
     ********************************************************************/
    let lastFrameTime = performance.now();
    let frameCount = 0;
    let fpsTimer = performance.now();

    function animateLoop(now) {
      requestAnimationFrame(animateLoop);

      const dt = (now - lastFrameTime) / 1000;
      lastFrameTime = now;

      // Live FPS Counter
      frameCount++;
      if (now - fpsTimer >= 500) {
        const fps = Math.min(120, Math.round((frameCount * 1000) / (now - fpsTimer)));
        document.getElementById('fps-counter').textContent = `${fps} FPS`;
        frameCount = 0;
        fpsTimer = now;
      }

      // Advance Timeline Playhead if playing
      if (state.isPlaying) {
        let nextTime = state.currentTime + dt;
        if (nextTime >= state.duration) {
          nextTime = 0; // Seamless loop
        }
        evaluateTimelineAtTime(nextTime);
      }

      // Optional Continuous Floating Levitation
      if (state.idleFloat) {
        deviceGroup.position.y = Math.sin(now * 0.0025) * 0.65;
      }

      // Update Procedural or Video Screen Texture
      demoAnimTick++;
      if (!customUploadedImage || uploadedVideoElement) {
        drawProceduralScreen(demoAnimTick);
      }

      renderer.render(scene, camera);
    }

    window.onload = function () {
      lucide.createIcons();
      initThreeScene();
      switchTab('device');
      renderTemplateLibraryUI();
      renderKeyframeDiamonds();
      evaluateTimelineAtTime(3.01); // Match Rotato snapshot initial playhead
      requestAnimationFrame(animateLoop);
    };
  </script>
</body>
</html>