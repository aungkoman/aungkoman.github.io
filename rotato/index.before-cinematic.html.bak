        <span id="export-time-progress">0.00s / 4.00s</span>
        <span id="export-pct-label" class="text-emerald-400 font-semibold">0%</span>
      </div>

      <div class="pt-2 flex justify-end">
        <button onclick="cancelActiveVideoExport()" class="px-4 py-2 rounded-xl bg-zinc-200 dark:bg-surface-card hover:bg-red-500/20 hover:text-red-400 text-xs font-semibold transition">
          Cancel Export
        </button>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toast-box" class="fixed bottom-6 right-6 z-50 pointer-events-none opacity-0 translate-y-2 transition-all duration-200 bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 px-4 py-2.5 rounded-xl shadow-xl text-xs font-medium flex items-center gap-2">
