<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Rotato Studio Local — 3D Device Mockup & Animation Engine</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Font Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Three.js r128 -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <!-- GLTFLoader for Real 3D GLTF/GLB Device Assets -->
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
  <!-- RGBELoader for Studio Environment Reflection Maps -->
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/RGBELoader.js"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', ' system-ui', 'sans-serif'] },
          colors: {
            surface: {
              DEFAULT: '#121216',
              panel: '#18181d',
              card: '#202027',
              hover: '#2a2a33',
              border: '#2d2d37'
            }
          }
        }
      }
    };
  </script>

  <style>
    * { box-sizing: border-box; user-select: none; }
    body { font-family: 'Inter', sans-serif; overflow: hidden; }
    
    /* Custom Scrollbars */
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(150, 150, 165, 0.25); border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(150, 150, 165, 0.45); }

    /* Checkerboard for Transparent Background */
    .checkerboard {
      background-image: 
        linear-gradient(45deg, rgba(128,128,128,0.14) 25%, transparent 25%), 
        linear-gradient(-45deg, rgba(128,128,128,0.14) 25%, transparent 25%), 
        linear-gradient(45deg, transparent 75%, rgba(128,128,128,0.14) 75%), 
        linear-gradient(-45deg, transparent 75%, rgba(128,128,128,0.14) 75%);
      background-size: 20px 20px;
      background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
    }

    /* Custom Range Input */
    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      background: rgba(140, 140, 160, 0.2);
      height: 5px;
      border-radius: 999px;
      outline: none;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #10b981;
      cursor: pointer;
      border: 2px solid #ffffff;
      box-shadow: 0 1px 4px rgba(0,0,0,0.4);
      transition: transform 0.1s ease;
    }
    input[type="range"]::-webkit-slider-thumb:hover {
      transform: scale(1.15);
    }

    /* Playhead Polygon */
    .playhead-cap {
      clip-path: polygon(0 0, 100% 0, 100% 55%, 50% 100%, 0 55%);
    }
  </style>
</head>
<body class="bg-zinc-100 dark:bg-[#0d0d11] text-zinc-900 dark:text-zinc-100 h-screen w-screen flex flex-col">

  <!-- MAIN WORKSPACE -->
  <main class="flex-1 flex min-h-0 w-full overflow-hidden relative">

    <!-- 1. LEFT VERTICAL ICON SIDEBAR & INSPECTOR -->
    <aside class="flex h-full shrink-0 border-r border-zinc-200 dark:border-surface-border bg-white dark:bg-surface-panel z-30">
      
      <!-- Icon Rail -->
      <div class="w-16 flex flex-col items-center py-3 gap-1.5 border-r border-zinc-200 dark:border-surface-border bg-zinc-50/70 dark:bg-surface">
        <!-- Brand Logo -->
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-400 to-teal-600 flex items-center justify-center shadow-md shadow-emerald-500/20 mb-4 cursor-pointer" title="Rotato Local GPU Studio">
          <i data-lucide="box" class="w-5 h-5 text-white"></i>
        </div>

        <button onclick="switchTab('device')" id="tab-btn-device" class="sidebar-tab-btn active-tab flex flex-col items-center justify-center gap-1 w-13 h-14 px-2 rounded-xl text-xs font-medium transition-all">
          <i data-lucide="smartphone" class="w-4 h-4"></i>
          <span class="text-[10px]">Devices</span>
        </button>

        <button onclick="switchTab('camera')" id="tab-btn-camera" class="sidebar-tab-btn flex flex-col items-center justify-center gap-1 w-13 h-14 px-2 rounded-xl text-xs font-medium transition-all">
          <i data-lucide="video" class="w-4 h-4"></i>
          <span class="text-[10px]">Camera</span>
        </button>

        <button onclick="switchTab('templates')" id="tab-btn-templates" class="sidebar-tab-btn flex flex-col items-center justify-center gap-1 w-13 h-14 px-2 rounded-xl text-xs font-medium transition-all">
          <i data-lucide="sparkles" class="w-4 h-4"></i>
          <span class="text-[10px]">Templates</span>
        </button>

        <button onclick="switchTab('background')" id="tab-btn-background" class="sidebar-tab-btn flex flex-col items-center justify-center gap-1 w-13 h-14 px-2 rounded-xl text-xs font-medium transition-all">
          <i data-lucide="image" class="w-4 h-4"></i>
          <span class="text-[10px]">Scene</span>
        </button>

        <button onclick="switchTab('settings')" id="tab-btn-settings" class="sidebar-tab-btn flex flex-col items-center justify-center gap-1 w-13 h-14 px-2 rounded-xl text-xs font-medium transition-all">
          <i data-lucide="sliders" class="w-4 h-4"></i>
          <span class="text-[10px]">Render</span>
        </button>

        <div class="flex-1"></div>

        <!-- Theme Switcher -->
        <button onclick="toggleTheme()" class="flex flex-col items-center justify-center gap-1 w-12 h-12 rounded-xl text-zinc-500 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-200/50 dark:hover:bg-surface-hover transition-colors" title="Toggle Light/Dark Mode">
          <i data-lucide="sun-moon" class="w-4 h-4"></i>
          <span class="text-[9px]">Theme</span>
        </button>
      </div>

      <!-- Inspector Panel Content -->
      <div class="w-72 flex flex-col h-full overflow-y-auto p-4 space-y-5">
        
        <!-- Project Title Bar -->
        <div class="flex items-center justify-between border-b border-zinc-200 dark:border-surface-border pb-3">
          <div class="min-w-0">
            <span class="text-[10px] uppercase tracking-wider font-semibold text-emerald-500 block">Active Project</span>
            <h2 id="active-project-name" class="text-sm font-semibold truncate">Phone Tilted Zoom Out</h2>
          </div>
          <button onclick="resetEntireScene()" class="p-1.5 rounded-lg text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-surface-hover transition" title="Reset Scene">
            <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
          </button>
        </div>

        <!-- TAB 1: DEVICES -->
        <div id="tab-content-device" class="space-y-5">
          <!-- 3D Model Selector -->
          <div>
            <label class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider block mb-2.5">3D Hardware Model</label>
            <div class="grid grid-cols-3 gap-2">
              <button onclick="selectDeviceModel('iphone')" id="model-btn-iphone" class="device-model-btn flex flex-col items-center gap-1.5 p-2.5 rounded-xl border border-emerald-500 bg-emerald-500/10 text-emerald-500 transition">
                <i data-lucide="smartphone" class="w-5 h-5"></i>
                <span class="text-[11px] font-medium">iPhone 15</span>
              </button>
              <button onclick="selectDeviceModel('macbook')" id="model-btn-macbook" class="device-model-btn flex flex-col items-center gap-1.5 p-2.5 rounded-xl border border-zinc-200 dark:border-surface-border hover:bg-zinc-100 dark:hover:bg-surface-hover transition">
                <i data-lucide="laptop" class="w-5 h-5"></i>
                <span class="text-[11px] font-medium">MacBook</span>
              </button>
              <button onclick="selectDeviceModel('ipad')" id="model-btn-ipad" class="device-model-btn flex flex-col items-center gap-1.5 p-2.5 rounded-xl border border-zinc-200 dark:border-surface-border hover:bg-zinc-100 dark:hover:bg-surface-hover transition">
                <i data-lucide="tablet" class="w-5 h-5"></i>
                <span class="text-[11px] font-medium">iPad Pro</span>
              </button>
            </div>
          </div>

          <!-- MacBook Lid Angle Control (Conditional) -->
          <div id="macbook-lid-control" class="hidden p-3 rounded-xl bg-zinc-100 dark:bg-surface-card space-y-2">
            <div class="flex justify-between text-xs">
              <span class="font-medium">Laptop Lid Angle</span>
              <span id="lid-angle-label" class="text-emerald-400 font-mono">105°</span>
            </div>
            <input type="range" id="lid-angle-slider" min="0" max="135" value="105" class="w-full" oninput="updateMacbookLid(this.value)">
          </div>

          <!-- Screen Content Dropzone -->
          <div class="space-y-2">
            <label class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider block">Screen Design (Image / Video)</label>
            <div id="screen-dropzone" onclick="document.getElementById('screen-file-input').click()" class="border-2 border-dashed border-zinc-300 dark:border-zinc-700 hover:border-emerald-500 dark:hover:border-emerald-500 rounded-xl p-4 text-center cursor-pointer transition-all bg-zinc-50/50 dark:bg-surface-card/50 group">
              <input type="file" id="screen-file-input" accept="image/*,video/mp4,video/webm" class="hidden" onchange="handleScreenMediaUpload(event)">
              <div class="w-9 h-9 rounded-full bg-emerald-500/10 text-emerald-500 flex items-center justify-center mx-auto mb-2 group-hover:scale-110 transition-transform">
                <i data-lucide="upload-cloud" class="w-5 h-5"></i>
              </div>
              <p class="text-xs font-medium">Drop screenshot or video</p>
              <p class="text-[10px] text-zinc-400 mt-0.5">Supports PNG, JPG, WebP, MP4, WebM</p>
            </div>

            <!-- Built-in interactive UI presets -->
            <div class="flex items-center gap-1.5 pt-1">
              <span class="text-[10px] text-zinc-400">Demo Screens:</span>
              <button onclick="generateDemoScreen('fintech')" class="text-[10px] px-2 py-1 rounded bg-zinc-200 dark:bg-surface-card hover:bg-emerald-500 hover:text-white transition">Fintech App</button>
              <button onclick="generateDemoScreen('ai')" class="text-[10px] px-2 py-1 rounded bg-zinc-200 dark:bg-surface-card hover:bg-emerald-500 hover:text-white transition">AI Chat</button>
              <button onclick="generateDemoScreen('analytics')" class="text-[10px] px-2 py-1 rounded bg-zinc-200 dark:bg-surface-card hover:bg-emerald-500 hover:text-white transition">SaaS</button>
            </div>

            <!-- Screen Color Accuracy, Fit Mode, Brightness & Glass Glare Controls -->
            <div class="p-3 rounded-xl bg-zinc-100 dark:bg-surface-card space-y-3 mt-2 border border-zinc-200/60 dark:border-surface-border">
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold text-emerald-500 flex items-center gap-1">
                  <i data-lucide="palette" class="w-3.5 h-3.5"></i> True sRGB Display
                </span>
                <span class="text-[9px] px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-400 font-mono">toneMapped: false</span>
              </div>

              <!-- Object-Fit Toggle (Cover vs Contain) -->
              <div class="flex items-center justify-between text-xs">
                <span class="text-zinc-500 dark:text-zinc-400 text-[11px]">Aspect Fit</span>
                <div class="flex rounded-lg bg-zinc-200 dark:bg-surface p-0.5">
                  <button onclick="setScreenFitMode('cover')" id="fit-btn-cover" class="px-2 py-0.5 rounded-md text-[10px] font-medium bg-emerald-500 text-white transition">Cover / Fill</button>
                  <button onclick="setScreenFitMode('contain')" id="fit-btn-contain" class="px-2 py-0.5 rounded-md text-[10px] font-medium text-zinc-400 hover:text-white transition">Contain / Fit</button>
                </div>
              </div>

              <!-- Screen Brightness / Exposure Slider -->
              <div class="space-y-1">
                <div class="flex justify-between text-[11px]">
                  <span class="text-zinc-500 dark:text-zinc-400">Screen Brightness</span>
                  <span id="screen-brightness-val" class="font-mono text-emerald-400">100%</span>
                </div>
                <input type="range" id="screen-brightness-slider" min="40" max="150" step="1" value="100" class="w-full" oninput="updateScreenBrightness(this.value)">
              </div>

              <!-- Separate Glass Reflection / Glare Overlay Slider -->
              <div class="space-y-1">
                <div class="flex justify-between text-[11px]">
                  <span class="text-zinc-500 dark:text-zinc-400">Glass Glare Overlay</span>
                  <span id="screen-glare-val" class="font-mono text-emerald-400">4%</span>
                </div>
                <input type="range" id="screen-glare-slider" min="0" max="100" step="1" value="4" class="w-full" oninput="updateScreenGlare(this.value)">
              </div>

              <!-- Dynamic Island Toggle (for iPhone) -->
              <div id="dynamic-island-row" class="flex items-center justify-between pt-1 border-t border-zinc-200 dark:border-surface-border">
                <span class="text-[11px] text-zinc-500 dark:text-zinc-400">Dynamic Island Cutout</span>
                <button id="island-toggle-btn" onclick="toggleDynamicIsland()" role="switch" aria-checked="true" class="w-9 h-5 rounded-full bg-emerald-500 relative transition-colors">
                  <span id="island-toggle-knob" class="w-3.5 h-3.5 rounded-full bg-white shadow absolute left-0.5 top-0.5 translate-x-4 transition-transform"></span>
                </button>
              </div>
            </div>
          </div>

          <!-- Device Finish & Real Clay Mode -->
          <div class="space-y-3 pt-2 border-t border-zinc-200 dark:border-surface-border">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-xs font-medium block">Real Clay Mode</span>
                <span class="text-[10px] text-zinc-400">Minimalist matte monochrome</span>
              </div>
              <button id="clay-toggle-btn" onclick="toggleClayMode()" role="switch" aria-checked="false" class="w-10 h-5 rounded-full bg-zinc-300 dark:bg-zinc-700 relative transition-colors">
                <span id="clay-toggle-knob" class="w-4 h-4 rounded-full bg-white shadow absolute left-0.5 top-0.5 transition-transform"></span>
              </button>
            </div>

            <div>
              <label class="text-xs font-medium block mb-2">Hardware Finish</label>
              <div class="flex items-center gap-2">
                <button onclick="setDeviceColor('#27272a', 0.85, 0.2)" class="w-6 h-6 rounded-full bg-zinc-800 ring-2 ring-offset-2 ring-offset-white dark:ring-offset-surface-panel ring-emerald-500" title="Space Black Titanium"></button>
                <button onclick="setDeviceColor('#a8a29e', 0.88, 0.22)" class="w-6 h-6 rounded-full bg-stone-400 hover:scale-110 transition" title="Natural Titanium"></button>
                <button onclick="setDeviceColor('#e4e4e7', 0.9, 0.18)" class="w-6 h-6 rounded-full bg-zinc-200 border border-zinc-400 hover:scale-110 transition" title="Silver"></button>
                <button onclick="setDeviceColor('#d6b98c', 0.88, 0.2)" class="w-6 h-6 rounded-full bg-[#d6b98c] hover:scale-110 transition" title="Desert Gold"></button>
                <button onclick="setDeviceColor('#3b82f6', 0.75, 0.25)" class="w-6 h-6 rounded-full bg-blue-500 hover:scale-110 transition" title="Ultramarine"></button>
                <input type="color" id="custom-device-color" value="#27272a" oninput="setDeviceColor(this.value, 0.8, 0.25)" class="w-6 h-6 rounded cursor-pointer bg-transparent border-0" title="Custom Color">
              </div>
            </div>

            <!-- Device Tilt / Floating Offset -->
            <div class="space-y-2 pt-2">
              <div class="flex justify-between text-xs">
                <span class="text-zinc-400">Device Pitch (X°)</span>
                <span id="dev-rot-x-val" class="font-mono text-[11px]">0.0°</span>
              </div>
              <input type="range" id="dev-rot-x" min="-90" max="90" step="0.5" value="0" class="w-full" oninput="updateDeviceTransformFromUI()">

              <div class="flex justify-between text-xs">
                <span class="text-zinc-400">Device Yaw (Y°)</span>
                <span id="dev-rot-y-val" class="font-mono text-[11px]">0.0°</span>
              </div>
              <input type="range" id="dev-rot-y" min="-180" max="180" step="0.5" value="0" class="w-full" oninput="updateDeviceTransformFromUI()">

              <div class="flex justify-between text-xs">
                <span class="text-zinc-400">Device Roll (Z°)</span>
                <span id="dev-rot-z-val" class="font-mono text-[11px]">0.0°</span>
              </div>
              <input type="range" id="dev-rot-z" min="-90" max="90" step="0.5" value="0" class="w-full" oninput="updateDeviceTransformFromUI()">
            </div>
          </div>
        </div>

        <!-- TAB 2: CAMERA INSPECTOR (Matches Rotato DOM) -->
        <div id="tab-content-camera" class="hidden space-y-5">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Position & Rotation</span>
              <div class="flex items-center gap-1">
                <button onclick="copyCameraValues()" class="p-1 rounded hover:bg-zinc-200 dark:hover:bg-surface-hover text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition" title="Copy camera values">
                  <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                </button>
                <button onclick="pasteCameraValues()" class="p-1 rounded hover:bg-zinc-200 dark:hover:bg-surface-hover text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition" title="Paste camera values">
                  <i data-lucide="clipboard-paste" class="w-3.5 h-3.5"></i>
                </button>
              </div>
            </div>

            <!-- 3x2 Numeric Grid matching Rotato DOM -->
            <div class="grid grid-cols-3 gap-2 mb-3">
              <div class="space-y-1">
                <input id="cam-pos-x" type="number" step="0.5" value="0.00" oninput="applyCameraInputs()" class="w-full h-8 rounded-lg bg-zinc-100 dark:bg-surface-card text-center text-xs font-mono outline-none focus:ring-2 focus:ring-emerald-500">
                <p class="text-[10px] text-center text-zinc-400">Pos X</p>
              </div>
              <div class="space-y-1">
                <input id="cam-pos-y" type="number" step="0.5" value="0.00" oninput="applyCameraInputs()" class="w-full h-8 rounded-lg bg-zinc-100 dark:bg-surface-card text-center text-xs font-mono outline-none focus:ring-2 focus:ring-emerald-500">
                <p class="text-[10px] text-center text-zinc-400">Y</p>
              </div>
              <div class="space-y-1">
                <input id="cam-pos-z" type="number" step="0.5" value="30.52" oninput="applyCameraInputs()" class="w-full h-8 rounded-lg bg-zinc-100 dark:bg-surface-card text-center text-xs font-mono outline-none focus:ring-2 focus:ring-emerald-500">
                <p class="text-[10px] text-center text-zinc-400">Z</p>
              </div>
            </div>

            <div class="grid grid-cols-3 gap-2">
              <div class="space-y-1">
                <input id="cam-rot-x" type="number" step="1" value="0.0" oninput="applyCameraInputs()" class="w-full h-8 rounded-lg bg-zinc-100 dark:bg-surface-card text-center text-xs font-mono outline-none focus:ring-2 focus:ring-emerald-500">
                <p class="text-[10px] text-center text-zinc-400">Rot X°</p>
              </div>
              <div class="space-y-1">
                <input id="cam-rot-y" type="number" step="1" value="0.0" oninput="applyCameraInputs()" class="w-full h-8 rounded-lg bg-zinc-100 dark:bg-surface-card text-center text-xs font-mono outline-none focus:ring-2 focus:ring-emerald-500">
                <p class="text-[10px] text-center text-zinc-400">Y°</p>
              </div>
              <div class="space-y-1">
                <input id="cam-rot-z" type="number" step="1" value="0.0" oninput="applyCameraInputs()" class="w-full h-8 rounded-lg bg-zinc-100 dark:bg-surface-card text-center text-xs font-mono outline-none focus:ring-2 focus:ring-emerald-500">
                <p class="text-[10px] text-center text-zinc-400">Z°</p>
              </div>
            </div>
          </div>

          <!-- Camera Lens / FOV -->
          <div class="space-y-3 pt-3 border-t border-zinc-200 dark:border-surface-border">
            <div class="flex justify-between text-xs">
              <span class="font-medium">Telephoto Zoom (FOV)</span>
              <span id="fov-label" class="text-emerald-400 font-mono">35°</span>
            </div>
            <input type="range" id="cam-fov-slider" min="15" max="75" value="35" class="w-full" oninput="updateCameraFOV(this.value)">

            <!-- Easing Curve Selector -->
            <div class="space-y-1.5 pt-2">
              <label class="text-xs font-medium block">Animation Easing Curve</label>
              <select id="easing-curve-select" onchange="setEasingCurve(this.value)" class="w-full h-8 rounded-lg bg-zinc-100 dark:bg-surface-card px-2.5 text-xs outline-none border border-zinc-200/60 dark:border-surface-border focus:ring-2 focus:ring-emerald-500">
                <option value="cubic">Ease In-Out Cubic (Smooth)</option>
                <option value="expo">Expo Out (Cinema Snap)</option>
                <option value="spring">Spring / Overshoot (Dynamic)</option>
                <option value="linear">Linear (Constant Speed)</option>
              </select>
            </div>

            <!-- Zero-G Idle Float Toggle in Camera Inspector -->
            <div class="flex items-center justify-between pt-2">
              <div>
                <span class="text-xs font-medium block">Zero-G Idle Float</span>
                <span class="text-[10px] text-zinc-400">Continuous sine-wave levitation</span>
              </div>
              <button id="cam-float-toggle-btn" onclick="toggleIdleFloat()" role="switch" aria-checked="false" class="w-10 h-5 rounded-full bg-zinc-300 dark:bg-zinc-700 relative transition-colors">
                <span id="cam-float-toggle-knob" class="w-4 h-4 rounded-full bg-white shadow absolute left-0.5 top-0.5 transition-transform"></span>
              </button>
            </div>

            <div class="flex items-center justify-between pt-2">
              <div>
                <span class="text-xs font-medium block">Depth of Field Blur</span>
                <span class="text-[10px] text-zinc-400">Cinematic studio backdrop blur</span>
              </div>
              <button id="dof-toggle-btn" onclick="toggleDOF()" role="switch" aria-checked="false" class="w-10 h-5 rounded-full bg-zinc-300 dark:bg-zinc-700 relative transition-colors">
                <span id="dof-toggle-knob" class="w-4 h-4 rounded-full bg-white shadow absolute left-0.5 top-0.5 transition-transform"></span>
              </button>
            </div>
          </div>
        </div>

        <!-- TAB 3: TEMPLATES (16 Studio-Grade Choreographed Templates + Filter Pills) -->
        <div id="tab-content-templates" class="hidden space-y-3">
          <div class="flex items-center justify-between">
            <label class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">16 Studio Templates</label>
            <button onclick="openTemplateModal()" class="text-[11px] font-medium text-emerald-400 hover:underline flex items-center gap-1">
              <i data-lucide="layout-grid" class="w-3 h-3"></i>
              <span>Expand Grid</span>
            </button>
          </div>

          <!-- Category Filter Pills -->
          <div id="sidebar-template-filters" class="flex flex-wrap gap-1 pt-0.5">
            <button onclick="filterTemplates('all')" data-cat="all" class="tpl-filter-pill px-2 py-1 rounded-md text-[10px] font-semibold bg-emerald-500 text-white transition">All (16)</button>
            <button onclick="filterTemplates('popular')" data-cat="popular" class="tpl-filter-pill px-2 py-1 rounded-md text-[10px] font-medium bg-zinc-100 dark:bg-surface-card text-zinc-400 hover:text-white transition">Popular</button>
            <button onclick="filterTemplates('cinematic')" data-cat="cinematic" class="tpl-filter-pill px-2 py-1 rounded-md text-[10px] font-medium bg-zinc-100 dark:bg-surface-card text-zinc-400 hover:text-white transition">Cinematic</button>
            <button onclick="filterTemplates('promo')" data-cat="promo" class="tpl-filter-pill px-2 py-1 rounded-md text-[10px] font-medium bg-zinc-100 dark:bg-surface-card text-zinc-400 hover:text-white transition">Fast Promo</button>
            <button onclick="filterTemplates('laptop')" data-cat="laptop" class="tpl-filter-pill px-2 py-1 rounded-md text-[10px] font-medium bg-zinc-100 dark:bg-surface-card text-zinc-400 hover:text-white transition">Laptop & Pad</button>
            <button onclick="filterTemplates('floating')" data-cat="floating" class="tpl-filter-pill px-2 py-1 rounded-md text-[10px] font-medium bg-zinc-100 dark:bg-surface-card text-zinc-400 hover:text-white transition">Floating</button>
          </div>

          <!-- Dynamic Sidebar Template List -->
          <div id="sidebar-template-list" class="space-y-2 pt-1 pb-4"></div>
        </div>

        <!-- TAB 4: BACKGROUND & LIGHTING -->
        <div id="tab-content-background" class="hidden space-y-5">
          <div>
            <label class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider block mb-2">Backdrop Style</label>
            <div class="grid grid-cols-3 gap-1.5">
              <button onclick="setBackdropMode('gradient')" id="bg-mode-gradient" class="px-2.5 py-1.5 rounded-lg text-xs font-medium bg-emerald-500 text-white">Gradient</button>
              <button onclick="setBackdropMode('solid')" id="bg-mode-solid" class="px-2.5 py-1.5 rounded-lg text-xs font-medium bg-zinc-100 dark:bg-surface-card">Solid</button>
              <button onclick="setBackdropMode('transparent')" id="bg-mode-transparent" class="px-2.5 py-1.5 rounded-lg text-xs font-medium bg-zinc-100 dark:bg-surface-card">Alpha PNG</button>
            </div>
          </div>

          <div id="bg-color-pickers" class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs text-zinc-400">Primary Color</span>
              <input type="color" id="bg-color-1" value="#0f172a" oninput="updateBackdropColors()" class="w-8 h-6 rounded cursor-pointer bg-transparent">
            </div>
            <div id="bg-color-2-row" class="flex items-center justify-between">
              <span class="text-xs text-zinc-400">Secondary Glow</span>
              <input type="color" id="bg-color-2" value="#1e1b4b" oninput="updateBackdropColors()" class="w-8 h-6 rounded cursor-pointer bg-transparent">
            </div>
            <!-- Studio Swatches -->
            <div class="flex items-center gap-2 pt-1">
              <button onclick="setQuickGradient('#ffffff', '#f1f5f9')" class="w-6 h-6 rounded-full bg-white border border-zinc-300" title="Pure Studio White"></button>
              <button onclick="setQuickGradient('#0f172a', '#1e1b4b')" class="w-6 h-6 rounded-full bg-gradient-to-br from-slate-900 to-indigo-950" title="Midnight Cyber"></button>
              <button onclick="setQuickGradient('#064e3b', '#022c22')" class="w-6 h-6 rounded-full bg-gradient-to-br from-emerald-900 to-teal-950" title="Emerald Glow"></button>
              <button onclick="setQuickGradient('#4c1d95', '#1e1b4b')" class="w-6 h-6 rounded-full bg-gradient-to-br from-violet-900 to-indigo-950" title="Cosmic Purple"></button>
              <button onclick="setQuickGradient('#fbbf24', '#f97316')" class="w-6 h-6 rounded-full bg-gradient-to-br from-amber-400 to-orange-500" title="Warm Sunset"></button>
            </div>
          </div>

          <!-- Lighting & Shadows -->
          <div class="space-y-3 pt-3 border-t border-zinc-200 dark:border-surface-border">
            <label class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider block">Studio Lighting</label>
            <div class="space-y-1">
              <div class="flex justify-between text-xs">
                <span class="text-zinc-400">Key Light Intensity</span>
                <span id="light-int-val" class="font-mono">1.4x</span>
              </div>
              <input type="range" min="0.2" max="3" step="0.1" value="1.4" class="w-full" oninput="updateLightingIntensity(this.value)">
            </div>
            <div class="space-y-1">
              <div class="flex justify-between text-xs">
                <span class="text-zinc-400">Floor Contact Shadow</span>
                <span id="shadow-op-val" class="font-mono">65%</span>
              </div>
              <input type="range" min="0" max="1" step="0.05" value="0.65" class="w-full" oninput="updateShadowOpacity(this.value)">
            </div>
          </div>
        </div>

        <!-- TAB 5: RENDER & LOCAL GPU SETTINGS -->
        <div id="tab-content-settings" class="hidden space-y-4">
          <div class="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 space-y-1">
            <div class="flex items-center gap-1.5 text-emerald-400 text-xs font-semibold">
              <i data-lucide="cpu" class="w-4 h-4"></i>
              <span>100% Local Hardware Acceleration</span>
            </div>
            <p class="text-[11px] text-zinc-400 leading-relaxed">All 3D geometry, reflections, and video encoding run locally on your device's GPU. Zero cloud queues or watermarks.</p>
          </div>

          <div class="space-y-2">
            <label class="text-xs font-medium block">Photo Export Supersampling</label>
            <select id="export-scale-select" class="w-full h-9 rounded-lg bg-zinc-100 dark:bg-surface-card px-2.5 text-xs outline-none">
              <option value="1">1x Standard Resolution</option>
              <option value="2" selected>2x Retina Studio (4K Class)</option>
              <option value="4">4x Ultra Print (8K Class)</option>
            </select>
          </div>

          <div class="space-y-2">
            <label class="text-xs font-medium block">Floating Idle Animation</label>
            <button onclick="toggleIdleFloat()" id="idle-float-btn" class="w-full py-2 rounded-lg bg-zinc-100 dark:bg-surface-card hover:bg-emerald-500/20 text-xs font-medium transition">
              Enable Continuous Levitation: OFF
            </button>
          </div>
        </div>

      </div>
    </aside>

    <!-- 2. CENTER 3D VIEWPORT & FLOATING CONTROLS -->
    <section class="flex-1 flex flex-col min-w-0 h-full relative bg-zinc-200/70 dark:bg-[#09090c]">
      
      <!-- Top Floating Toolbar (Matches Rotato Header) -->
      <div class="pointer-events-none absolute inset-x-0 top-0 h-20 z-40 flex items-center justify-between px-6">
        <!-- Left GPU Status Pill + Quick Template Browser Trigger -->
        <div class="pointer-events-auto flex items-center gap-2">
          <div class="flex items-center gap-2 text-xs px-3 py-1.5 rounded-full bg-white/85 dark:bg-surface-panel/85 backdrop-blur-md border border-zinc-200/60 dark:border-surface-border shadow-sm">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="font-medium">Local WebGL GPU</span>
            <span id="fps-counter" class="text-zinc-400 font-mono text-[11px]">60 FPS</span>
          </div>
          <button onclick="openTemplateModal()" class="flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-full bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-400 border border-emerald-500/30 backdrop-blur-md font-medium transition shadow-sm">
            <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
            <span>Browse 16 Templates</span>
          </button>
        </div>

        <!-- Right Mode & Export Bar -->
        <div class="pointer-events-auto flex items-center gap-3">
          <!-- Photo / Video Mode Toggle -->
          <div class="flex items-center bg-white/90 dark:bg-surface-panel/90 backdrop-blur-md p-1 rounded-xl border border-zinc-200/60 dark:border-surface-border shadow-sm">
            <button onclick="setOutputMode('photo')" id="mode-btn-photo" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-all">
              <i data-lucide="image" class="w-3.5 h-3.5"></i>
              <span>Photo</span>
            </button>
            <button onclick="setOutputMode('video')" id="mode-btn-video" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-emerald-500 text-white shadow-sm transition-all">
              <i data-lucide="film" class="w-3.5 h-3.5"></i>
              <span>Video</span>
            </button>
          </div>

          <!-- Primary Export Button -->
          <button onclick="triggerExport()" id="export-main-btn" class="flex items-center justify-center gap-2 bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 hover:opacity-90 h-10 px-4 rounded-xl text-xs font-semibold shadow-lg transition">
            <i data-lucide="download" class="w-4 h-4"></i>
            <span id="export-btn-label">Export Video</span>
          </button>
        </div>
      </div>

      <!-- 3D Aspect-Ratio Stage Container -->
      <div class="flex-1 min-h-0 relative flex items-center justify-center p-6 overflow-hidden">
        <div id="stage-aspect-wrapper" class="relative w-full h-full max-w-full max-h-full m-auto flex items-center justify-center transition-all duration-200" style="aspect-ratio: 4 / 3;">
          <div id="canvas-backdrop" class="w-full h-full rounded-2xl overflow-hidden shadow-2xl border border-zinc-300/40 dark:border-white/10 relative" style="background: radial-gradient(circle at 50% 35%, #1e1b4b, #0f172a);">
            <div id="canvas-container" class="w-full h-full relative cursor-grab active:cursor-grabbing"></div>
            
            <!-- Recording Overlay Badge -->
            <div id="recording-badge" class="hidden absolute top-4 left-4 z-50 flex items-center gap-2 px-3 py-1.5 rounded-full bg-red-600 text-white text-xs font-semibold shadow-lg">
              <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
              <span id="recording-status-text">Recording GPU Stream... 0%</span>
            </div>
          </div>
        </div>

        <!-- Bottom Floating Pill Toolbar (Matches Rotato's exact 3x3 Rotation Matrix & Aspect Pill) -->
        <div class="absolute bottom-5 left-1/2 -translate-x-1/2 z-40">
          <div class="flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/90 dark:bg-surface-panel/90 backdrop-blur-md border border-zinc-200 dark:border-surface-border shadow-xl">
            
            <!-- Aspect Ratio Selector -->
            <div class="flex items-center gap-1 pr-2 border-r border-zinc-200 dark:border-surface-border">
              <i data-lucide="frame" class="w-3.5 h-3.5 text-zinc-400 mr-1"></i>
              <button onclick="setStageAspect('16/9', '16:9')" class="aspect-pill px-2 py-1 rounded-md text-xs hover:bg-zinc-200/60 dark:hover:bg-surface-hover transition">16:9</button>
              <button onclick="setStageAspect('4/3', '4:3')" class="aspect-pill px-2 py-1 rounded-md text-xs bg-emerald-500/20 text-emerald-400 font-semibold transition">4:3</button>
              <button onclick="setStageAspect('1/1', '1:1')" class="aspect-pill px-2 py-1 rounded-md text-xs hover:bg-zinc-200/60 dark:hover:bg-surface-hover transition">1:1</button>
              <button onclick="setStageAspect('9/16', '9:16')" class="aspect-pill px-2 py-1 rounded-md text-xs hover:bg-zinc-200/60 dark:hover:bg-surface-hover transition">9:16</button>
            </div>

            <!-- Quick Color Swatch Button -->
            <button onclick="switchTab('background')" class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg hover:bg-zinc-200/60 dark:hover:bg-surface-hover text-xs transition">
              <span class="text-zinc-500 dark:text-zinc-300">Colors</span>
              <span id="pill-color-dot" class="w-3.5 h-3.5 rounded-full border border-white/30 bg-indigo-950"></span>
            </button>

            <!-- 3x3 Quick Rotation Dot Matrix + Z Tilt (From Rotato DOM) -->
            <div class="flex items-center gap-1.5 pl-2 border-l border-zinc-200 dark:border-surface-border">
              <div class="grid grid-cols-3 gap-1 p-1" style="width: 34px; height: 34px;">
                <div></div>
                <button onclick="nudgeDeviceRotation(-15, 0, 0)" class="w-2.5 h-2.5 rounded-full bg-[#568F44] hover:scale-125 transition" title="Rotate X Up"></button>
                <div></div>
                <button onclick="nudgeDeviceRotation(0, -20, 0)" class="w-2.5 h-2.5 rounded-full bg-[#C85221] hover:scale-125 transition" title="Rotate Y Left"></button>
                <button onclick="resetDeviceRotation()" class="w-2.5 h-2.5 rounded-full bg-[#B28ECB] hover:scale-125 transition" title="Reset Rotation"></button>
                <button onclick="nudgeDeviceRotation(0, 20, 0)" class="w-2.5 h-2.5 rounded-full bg-[#C85221] hover:scale-125 transition" title="Rotate Y Right"></button>
                <div></div>
                <button onclick="nudgeDeviceRotation(15, 0, 0)" class="w-2.5 h-2.5 rounded-full bg-[#568F44] hover:scale-125 transition" title="Rotate X Down"></button>
                <div></div>
              </div>
              <div class="flex flex-col gap-1">
                <button onclick="nudgeDeviceRotation(0, 0, 12)" class="text-[#6DA8D5] hover:scale-125 transition" title="Tilt Z Counter-Clockwise">
                  <i data-lucide="corner-down-left" class="w-3 h-3"></i>
                </button>
                <button onclick="nudgeDeviceRotation(0, 0, -12)" class="text-[#6DA8D5] hover:scale-125 transition" title="Tilt Z Clockwise">
                  <i data-lucide="corner-down-right" class="w-3 h-3"></i>
                </button>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- 3. BOTTOM KEYFRAME TIMELINE PANEL (Matches Rotato Timeline) -->
      <section id="timeline-panel" class="h-36 shrink-0 border-t border-zinc-200 dark:border-surface-border bg-white dark:bg-surface-panel flex flex-col select-none z-30">
        
        <!-- Timeline Header & Ruler Row -->
        <div class="flex h-10 border-b border-zinc-200 dark:border-surface-border items-center">
          <!-- Left Transport Controls (300px fixed width matching Rotato) -->
          <div class="w-72 shrink-0 flex items-center gap-1.5 px-3 border-r border-zinc-200 dark:border-surface-border h-full">
            <button onclick="togglePlayTimeline()" id="timeline-play-btn" class="w-7 h-7 rounded-lg bg-emerald-500 text-white flex items-center justify-center hover:bg-emerald-600 transition" title="Play / Pause (Space)">
              <i data-lucide="play" class="w-3.5 h-3.5 fill-current"></i>
            </button>
            <button onclick="captureKeyframeAtCurrentTime()" class="px-2 h-7 rounded-lg bg-zinc-100 dark:bg-surface-card hover:bg-emerald-500/20 hover:text-emerald-400 text-[11px] font-medium flex items-center gap-1 transition" title="Save current Camera & Device pose at Playhead">
              <i data-lucide="plus" class="w-3 h-3"></i>
              <span>Keyframe</span>
            </button>
            <!-- Easing Badge in Transport Bar -->
            <button onclick="cycleEasingMode()" id="timeline-easing-btn" class="px-2 h-7 rounded-lg bg-zinc-100 dark:bg-surface-card hover:bg-indigo-500/20 hover:text-indigo-300 text-[10px] font-mono text-zinc-400 transition" title="Click to cycle Easing Curve">
              Cubic
            </button>

            <div class="ml-auto flex items-center gap-1">
              <div class="relative w-14">
                <input id="current-time-input" type="text" readonly value="0.00" class="w-full h-6 rounded bg-zinc-100 dark:bg-surface-card pr-3.5 text-right text-[11px] font-mono">
                <span class="pointer-events-none absolute right-1 top-1 text-[10px] text-zinc-400">s</span>
              </div>
              <span class="text-zinc-500 text-xs">/</span>
              <div class="relative w-14">
                <input id="duration-input" type="number" step="0.5" min="1" max="12" value="4.00" onchange="updateTimelineDuration(this.value)" class="w-full h-6 rounded bg-zinc-100 dark:bg-surface-card pr-3.5 text-right text-[11px] font-mono outline-none">
                <span class="pointer-events-none absolute right-1 top-1 text-[10px] text-zinc-400">s</span>
              </div>
            </div>
          </div>

          <!-- Right Interactive Time Ruler -->
          <div id="timeline-ruler" class="relative flex-1 h-full overflow-hidden cursor-ew-resize bg-zinc-50/60 dark:bg-surface/60" onmousedown="startScrubbing(event)">
            <!-- Time Ticks -->
            <div id="ruler-ticks" class="absolute inset-0 pointer-events-none flex items-end pb-1 px-4 justify-between text-[10px] font-mono text-zinc-400">
              <span>0s</span><span>1s</span><span>2s</span><span>3s</span><span>4s</span>
            </div>
          </div>
        </div>

        <!-- Timeline Tracks Area -->
        <div class="flex-1 relative flex flex-col justify-center divide-y divide-zinc-200/50 dark:divide-surface-border/50 overflow-hidden">
          
          <!-- Playhead Vertical Line Overlay -->
          <div id="playhead-line" class="pointer-events-none absolute top-0 bottom-0 z-40 w-px bg-emerald-400" style="left: 288px;">
            <div class="w-3 h-4 -left-1.5 -top-0.5 absolute bg-emerald-400 playhead-cap"></div>
          </div>

          <!-- Track 1: Camera Animation Track -->
          <div class="flex h-11 items-center">
            <div class="w-72 shrink-0 px-3 flex items-center justify-between border-r border-zinc-200 dark:border-surface-border h-full text-xs">
              <div class="flex items-center gap-2">
                <i data-lucide="camera" class="w-3.5 h-3.5 text-emerald-400"></i>
                <span class="font-medium">Camera Orbit & Zoom</span>
              </div>
              <span id="keyframe-count-badge" class="text-[10px] px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-surface-card text-zinc-400 font-mono">2 keys</span>
            </div>
            <div id="camera-track-lane" class="relative flex-1 h-full flex items-center px-4" onmousedown="startScrubbing(event)">
              <!-- Dynamic Keyframe Span Bar & Diamonds injected by JS -->
              <div id="keyframe-bar" class="h-6 rounded-md bg-emerald-500/20 border border-emerald-500/40 relative w-full flex items-center"></div>
            </div>
          </div>

          <!-- Track 2: Device 3D Model Track -->
          <div class="flex h-11 items-center">
            <div class="w-72 shrink-0 px-3 flex items-center justify-between border-r border-zinc-200 dark:border-surface-border h-full text-xs">
              <div class="flex items-center gap-2">
                <i data-lucide="smartphone" class="w-3.5 h-3.5 text-indigo-400"></i>
                <span id="timeline-device-label" class="font-medium">iPhone 15 Pro</span>
              </div>
              <button onclick="document.getElementById('screen-file-input').click()" class="text-[10px] text-emerald-400 hover:underline">+ Media</button>
            </div>
            <div class="relative flex-1 h-full flex items-center px-4" onmousedown="startScrubbing(event)">
              <div class="h-5 rounded-md bg-indigo-500/15 border border-indigo-500/30 w-full flex items-center px-2 text-[10px] text-indigo-300 truncate">
                <span id="timeline-media-name">Interactive Canvas UI (60 FPS)</span>
              </div>
            </div>
          </div>

        </div>
      </section>

    </section>
  </main>

  <!-- FULLSCREEN VISUAL TEMPLATE GALLERY MODAL -->
  <div id="template-gallery-modal" class="hidden fixed inset-0 z-50 bg-black/75 backdrop-blur-md flex items-center justify-center p-6">
    <div class="bg-white dark:bg-surface-panel border border-zinc-200 dark:border-surface-border rounded-2xl max-w-5xl w-full max-h-[86vh] flex flex-col shadow-2xl overflow-hidden">
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-zinc-200 dark:border-surface-border flex items-center justify-between">
        <div>
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 text-[10px] font-semibold uppercase tracking-wider">Studio Library</span>
            <h3 class="text-base font-bold">Choreographed 3D Mockup Templates</h3>
          </div>
          <p class="text-xs text-zinc-400 mt-0.5">Click any template to load its multi-keyframe camera rig, device lighting, and easing choreography.</p>
        </div>
        <button onclick="closeTemplateModal()" class="p-2 rounded-xl bg-zinc-100 dark:bg-surface-card hover:bg-zinc-200 dark:hover:bg-surface-hover text-zinc-400 hover:text-white transition">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <!-- Modal Filter Bar -->
      <div class="px-6 py-3 bg-zinc-50 dark:bg-surface border-b border-zinc-200 dark:border-surface-border flex items-center justify-between flex-wrap gap-2">
        <div class="flex items-center gap-1.5 flex-wrap">
          <button onclick="filterTemplates('all')" data-cat="all" class="tpl-filter-pill px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-500 text-white transition">All Templates (16)</button>
          <button onclick="filterTemplates('popular')" data-cat="popular" class="tpl-filter-pill px-3 py-1.5 rounded-lg text-xs font-medium bg-zinc-200/70 dark:bg-surface-card text-zinc-400 hover:text-white transition">Popular Hits</button>
          <button onclick="filterTemplates('cinematic')" data-cat="cinematic" class="tpl-filter-pill px-3 py-1.5 rounded-lg text-xs font-medium bg-zinc-200/70 dark:bg-surface-card text-zinc-400 hover:text-white transition">Cinematic Reveals</button>
          <button onclick="filterTemplates('promo')" data-cat="promo" class="tpl-filter-pill px-3 py-1.5 rounded-lg text-xs font-medium bg-zinc-200/70 dark:bg-surface-card text-zinc-400 hover:text-white transition">Fast Promo & Reels</button>
          <button onclick="filterTemplates('laptop')" data-cat="laptop" class="tpl-filter-pill px-3 py-1.5 rounded-lg text-xs font-medium bg-zinc-200/70 dark:bg-surface-card text-zinc-400 hover:text-white transition">Laptop & iPad</button>
          <button onclick="filterTemplates('floating')" data-cat="floating" class="tpl-filter-pill px-3 py-1.5 rounded-lg text-xs font-medium bg-zinc-200/70 dark:bg-surface-card text-zinc-400 hover:text-white transition">Zero-G Floating</button>
        </div>
        <div class="text-[11px] text-zinc-400 font-mono">
          Active Easing: <span id="modal-easing-indicator" class="text-emerald-400">Ease In-Out Cubic</span>
        </div>
      </div>

      <!-- Modal Cards Grid -->
      <div id="modal-template-grid" class="p-6 overflow-y-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5"></div>
    </div>
  </div>

  <!-- VIDEO RENDER PROGRESS & CANCEL MODAL -->
  <div id="video-export-modal" class="hidden fixed inset-0 z-50 bg-black/75 backdrop-blur-md flex items-center justify-center p-6">
    <div class="bg-white dark:bg-surface-panel border border-zinc-200 dark:border-surface-border rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="w-3 h-3 rounded-full bg-red-500 animate-ping"></span>
          <h3 class="text-sm font-bold">Rendering Local GPU Video</h3>
        </div>
        <span id="export-codec-badge" class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-400">WEBM / 60 FPS</span>
      </div>

      <p id="export-modal-status" class="text-xs text-zinc-400">Encoding even-dimension hardware stream...</p>

      <div class="w-full h-2.5 rounded-full bg-zinc-200 dark:bg-surface-card overflow-hidden">
        <div id="export-progress-bar" class="h-full bg-gradient-to-r from-emerald-500 to-teal-400 transition-all duration-75" style="width: 0%;"></div>
